#!/usr/bin/python3
"""Print this session's Cost line for its handoff entry.

    framework/adapters/claude-code/cost <platform> <role>
    framework/adapters/claude-code/cost --orchestration

<platform> is iOS, Android or shared; <role> is product, builder or reviewer.
Paste the line it prints as the last line of the handoff entry
(`measures.md`, Cost per session).

`--orchestration` is for an orchestrator's report to the product owner
(`orchestrate.md`): it prints the whole session's figures labelled as the
orchestration session's total, never as a Cost line, and leaves the
previous-line state alone. A subagent can't use it.

Where each figure comes from:

- Dollars and agent time: the cost cache the status line keeps for this
  session (`statusline`): Claude Code's estimate of the session's cost at
  list price, and its API duration. The API duration is the model's own
  time; it leaves out tool runs such as builds and tests, and never counts
  time waiting for a human.
- Tokens: on the orchestrating session, the sum of every request in its
  transcript and its subagents' transcripts (input, output, cache read and
  cache creation), deduplicated by request id. In a subagent, only that
  subagent's transcript is counted. The transcript's format isn't documented
  and the sum has been seen to fall short of Claude Code's own exit-time
  total, so the figure is printed as a lower bound, `≥ N tokens`.
- Dollars and agent time: Claude Code exposes these only for the whole
  session, so a subagent prints them as `not recorded` rather than labelling
  the orchestrating session's figures as its own.
- Since the previous Cost line: from the second line for the same transcript,
  the same figures less those of its previous line. Each subagent keeps its
  own previous-line state, so it never uses the orchestrating session's line
  or another subagent's line.

The session is found through DUAL_NATIVE_SESSION_ID and
DUAL_NATIVE_TRANSCRIPT, which `session-start` exports. Any figure that can't
be read prints `not recorded`. Exit 0 whenever a line was printed; 2 for bad
arguments.
"""

import glob
import json
import os
import sys
import time

CACHE_DIR = os.path.join(
    os.environ.get("XDG_CACHE_HOME") or os.path.join(os.path.expanduser("~"), ".cache"),
    "dual-native",
    "claude-code",
)
PLATFORMS = ("iOS", "Android", "shared")
ROLES = ("product", "builder", "reviewer")
TOKEN_FIELDS = ("input_tokens", "output_tokens", "cache_read_input_tokens", "cache_creation_input_tokens")
STALE_AFTER = 10 * 60  # seconds without a status line refresh


def usage():
    sys.stderr.write("usage: cost <iOS|Android|shared> <product|builder|reviewer>\n       cost --orchestration\n")
    return 2


def read_cache(session_id):
    if not session_id:
        return None
    path = os.path.join(CACHE_DIR, session_id + ".json")
    try:
        with open(path, encoding="utf-8") as f:
            record = json.load(f)
    except (OSError, ValueError):
        return None
    return record if isinstance(record, dict) else None


def transcript_scope(transcript, session_id):
    """Return whether this is a subagent transcript and its state-file suffix."""
    if not transcript or not session_id:
        return "total", None
    subagents_dir = os.path.dirname(os.path.normpath(transcript))
    session_dir = os.path.dirname(subagents_dir)
    agent_file = os.path.basename(transcript)
    if (os.path.basename(subagents_dir) == "subagents"
            and os.path.basename(session_dir) == session_id
            and agent_file.endswith(".jsonl")):
        return "subagent", agent_file
    return "total", None


def sum_tokens(transcript, session_id, scope):
    """Total tokens for this transcript scope, last entry per request id."""
    if not transcript or not os.path.isfile(transcript):
        return None
    paths = [transcript]
    if scope == "total" and session_id:
        paths += sorted(glob.glob(os.path.join(os.path.dirname(transcript), session_id, "subagents", "*.jsonl")))
    usage_by_request = {}
    for path in paths:
        try:
            with open(path, encoding="utf-8") as f:
                for line in f:
                    try:
                        entry = json.loads(line)
                    except ValueError:
                        continue
                    if not isinstance(entry, dict) or entry.get("type") != "assistant":
                        continue
                    message = entry.get("message")
                    usage = message.get("usage") if isinstance(message, dict) else None
                    if not isinstance(usage, dict):
                        continue
                    key = entry.get("requestId") or entry.get("uuid") or id(entry)
                    usage_by_request[key] = usage
        except OSError:
            continue
    total = 0
    for usage in usage_by_request.values():
        for field in TOKEN_FIELDS:
            value = usage.get(field)
            if isinstance(value, (int, float)):
                total += int(value)
    return total


def last_line_path(session_id, scope, subagent_transcript_name):
    if not session_id or os.sep in session_id:
        return None
    if scope == "subagent":
        if not subagent_transcript_name or os.sep in subagent_transcript_name:
            return None
        return os.path.join(CACHE_DIR, "%s.%s.last-cost.json" % (session_id, subagent_transcript_name))
    return os.path.join(CACHE_DIR, session_id + ".last-cost.json")


def read_last(path):
    """The figures behind the session's previous Cost line, or None for its first."""
    if not path:
        return None
    try:
        with open(path, encoding="utf-8") as f:
            record = json.load(f)
    except (OSError, ValueError):
        return None
    return record if isinstance(record, dict) else None


def save_last(path, figures):
    if not path:
        return
    try:
        os.makedirs(CACHE_DIR, exist_ok=True)
        tmp = "%s.%d.tmp" % (path, os.getpid())
        with open(tmp, "w", encoding="utf-8") as f:
            json.dump(figures, f)
        os.replace(tmp, path)
    except OSError:
        pass


def since(now, previous):
    """Each figure less the previous line's, or not recorded where either is missing."""
    def delta(key):
        a, b = now.get(key), previous.get(key)
        if isinstance(a, (int, float)) and isinstance(b, (int, float)):
            return max(0, a - b)
        return None

    tokens, dollars, api_ms = delta("tokens"), delta("dollars"), delta("api_ms")
    return (
        "≥ {:,} tokens".format(int(tokens)) if tokens is not None else "not recorded",
        "$%.2f" % dollars if dollars is not None else "not recorded",
        duration(api_ms) if api_ms is not None else "not recorded",
    )


def duration(ms):
    seconds = int(round(ms / 1000.0))
    hours, rest = divmod(seconds, 3600)
    minutes, secs = divmod(rest, 60)
    if hours:
        return "%dh %02dm %02ds" % (hours, minutes, secs)
    return "%dm %02ds" % (minutes, secs)


def main(argv):
    orchestration = argv[1:] == ["--orchestration"]
    if not orchestration and (len(argv) != 3 or argv[1] not in PLATFORMS or argv[2] not in ROLES):
        return usage()
    platform, role = (None, None) if orchestration else (argv[1], argv[2])

    session_id = os.environ.get("DUAL_NATIVE_SESSION_ID")
    cache = read_cache(session_id)
    transcript = os.environ.get("DUAL_NATIVE_TRANSCRIPT") or (cache or {}).get("transcript_path")
    scope, subagent_transcript_name = transcript_scope(transcript, session_id)
    if orchestration and scope == "subagent":
        sys.stderr.write("cost: --orchestration is the orchestrating session's total; a subagent records its own Cost line\n")
        return 2

    tokens = dollars = agent_time = "not recorded"
    dollars_usd = api_ms = None
    notes = []
    if not session_id:
        notes.append("DUAL_NATIVE_SESSION_ID isn't set: is the adapter's SessionStart hook configured?")
    if scope == "subagent":
        notes.append("dollars and agent time aren't recorded for a subagent: Claude Code exposes them only for the whole session")
    elif cache:
        cost = cache.get("cost") or {}
        if isinstance(cost.get("total_cost_usd"), (int, float)):
            dollars_usd = cost["total_cost_usd"]
            dollars = "$%.2f" % dollars_usd
        if isinstance(cost.get("total_api_duration_ms"), (int, float)):
            api_ms = cost["total_api_duration_ms"]
            agent_time = duration(api_ms)
        saved_at = cache.get("saved_at")
        if isinstance(saved_at, (int, float)) and time.time() - saved_at > STALE_AFTER:
            notes.append("the cost cache was last refreshed %s ago; the status line may not be running" % duration((time.time() - saved_at) * 1000))
    elif session_id:
        notes.append("no cost cache for this session: is the adapter's status line configured?")
    total = sum_tokens(transcript, session_id, scope)
    if total is not None:
        tokens = "≥ {:,} tokens".format(total)
    elif transcript:
        notes.append("transcript not found at %s" % transcript)

    if orchestration:
        line = "Orchestration session total, includes the role subagents; not a role cost: %s · %s · %s" % (tokens, dollars, agent_time)
    else:
        figures = {"tokens": total, "dollars": dollars_usd, "api_ms": api_ms}
        line = "Cost: %s · %s · %s · %s · %s · %s" % (platform, role, scope, tokens, dollars, agent_time)
        last_path = last_line_path(session_id, scope, subagent_transcript_name)
        previous = read_last(last_path)
        if previous is not None:
            line += " · since the previous Cost line: %s · %s · %s" % since(figures, previous)
        save_last(last_path, figures)

    print(line)
    for note in notes:
        sys.stderr.write("cost: %s\n" % note)
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv))
