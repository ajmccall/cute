#!/usr/bin/python3
"""Self-test for the Claude Code adapter's commands.

Runs `statusline`, `cost` and `session-start` against fixtures in a temp
folder, with HOME and the Claude config directory pointed there, so nothing
touches the real caches. Also checks that `settings.json` parses, every
command it names exists and it pins no skills. Run it by hand after any change to this folder and
show its output on the change request:

    framework/adapters/claude-code/test

Exit 0 when every case passes.
"""

import json
import os
import re
import shutil
import stat
import subprocess
import sys
import tempfile
import textwrap

HERE = os.path.dirname(os.path.realpath(__file__))
HOOKS_DIR = os.path.normpath(os.path.join(HERE, "..", "..", "hooks"))

results = []


def report(name, ok, detail=""):
    results.append(ok)
    print("%s  %s%s" % ("PASS" if ok else "FAIL", name, ("\n      " + detail.strip().replace("\n", "\n      ")) if detail and not ok else ""))


def run(cmd, env, stdin="", cwd=None):
    return subprocess.run(cmd, input=stdin, env=env, cwd=cwd, capture_output=True, text=True)


def make_env(home):
    env = {k: v for k, v in os.environ.items() if not k.startswith(("DUAL_NATIVE_", "CLAUDE_", "XDG_", "GIT_"))}
    env["HOME"] = home
    env["CLAUDE_CONFIG_DIR"] = os.path.join(home, "claude")
    env["GIT_CONFIG_NOSYSTEM"] = "1"
    env["GIT_CONFIG_GLOBAL"] = os.devnull
    return env


def write(path, text, executable=False):
    os.makedirs(os.path.dirname(path), exist_ok=True)
    with open(path, "w", encoding="utf-8") as f:
        f.write(textwrap.dedent(text).lstrip("\n"))
    if executable:
        os.chmod(path, os.stat(path).st_mode | stat.S_IXUSR | stat.S_IXGRP | stat.S_IXOTH)


def status_payload(session_id, cwd):
    return {
        "session_id": session_id,
        "version": "2.1.302",
        "cwd": cwd,
        "transcript_path": os.path.join(cwd, "transcripts", session_id + ".jsonl"),
        "model": {"id": "claude-example", "display_name": "Example"},
        "workspace": {"current_dir": cwd, "project_dir": cwd},
        "cost": {
            "total_cost_usd": 1.2345,
            "total_duration_ms": 3600000,
            "total_api_duration_ms": 65400,
            "total_lines_added": 1,
            "total_lines_removed": 0,
        },
        "context_window": {"used_percentage": 42.7, "remaining_percentage": 57.3},
    }


def assistant(request_id, usage, extra=None):
    entry = {"type": "assistant", "requestId": request_id, "uuid": request_id + "-u", "message": {"usage": usage}}
    entry.update(extra or {})
    return json.dumps(entry)


# --- statusline ---------------------------------------------------------------

def test_statusline(root, env):
    statusline = os.path.join(HERE, "statusline")
    cwd = os.path.join(root, "project")
    os.makedirs(cwd)
    payload = status_payload("sess-1", cwd)
    cache = os.path.join(root, ".cache", "dual-native", "claude-code", "sess-1.json")

    out = run([statusline], env, stdin=json.dumps(payload))
    saved = None
    if os.path.isfile(cache):
        with open(cache, encoding="utf-8") as f:
            saved = json.load(f)
    report(
        "statusline saves the session's cost block to the cache",
        out.returncode == 0 and saved is not None and saved.get("cost", {}).get("total_cost_usd") == 1.2345
        and saved.get("transcript_path") == payload["transcript_path"] and "saved_at" in saved,
        out.stdout + out.stderr,
    )
    line = out.stdout.strip()
    report(
        "statusline prints the default line without a passthrough",
        line == "project | Example | 42% | $1.23",
        "got: %r" % line,
    )

    write(os.path.join(env["CLAUDE_CONFIG_DIR"], "dual-native-statusline"), """
        #!/bin/sh
        printf 'custom %s' "$(cat | /usr/bin/python3 -c 'import json,sys; print(json.load(sys.stdin)["model"]["display_name"])')"
        """, executable=True)
    out = run([statusline], env, stdin=json.dumps(payload))
    report(
        "statusline hands the JSON to the passthrough script when one exists",
        out.returncode == 0 and out.stdout.strip() == "custom Example",
        out.stdout + out.stderr,
    )

    write(os.path.join(env["CLAUDE_CONFIG_DIR"], "dual-native-statusline"), "#!/bin/sh\nexit 3\n", executable=True)
    out = run([statusline], env, stdin=json.dumps(payload))
    report(
        "statusline falls back to the default line when the passthrough fails",
        out.returncode == 0 and out.stdout.strip() == "project | Example | 42% | $1.23",
        out.stdout + out.stderr,
    )
    os.remove(os.path.join(env["CLAUDE_CONFIG_DIR"], "dual-native-statusline"))

    out = run([statusline], env, stdin="not json")
    report("statusline survives bad input", out.returncode == 0, out.stdout + out.stderr)

    out = run([statusline], env, stdin=json.dumps({"session_id": "../escape", "cost": {}}))
    report(
        "statusline refuses a session id that would leave the cache folder",
        out.returncode == 0 and not os.path.exists(os.path.join(root, ".cache", "dual-native", "escape.json")),
        out.stdout + out.stderr,
    )


# --- cost -----------------------------------------------------------------------

def test_cost(root, env):
    cost = os.path.join(HERE, "cost")
    statusline = os.path.join(HERE, "statusline")
    cwd = os.path.join(root, "project")
    payload = status_payload("sess-2", cwd)
    run([statusline], env, stdin=json.dumps(payload))  # fills the cache

    transcript = payload["transcript_path"]
    write(transcript, "\n".join([
        json.dumps({"type": "user", "message": {"role": "user"}}),
        assistant("req-a", {"input_tokens": 10, "output_tokens": 5, "cache_read_input_tokens": 100, "cache_creation_input_tokens": 200}),
        assistant("req-a", {"input_tokens": 10, "output_tokens": 5, "cache_read_input_tokens": 100, "cache_creation_input_tokens": 250}),
        "not json at all",
        assistant("req-b", {"input_tokens": 1, "output_tokens": 2, "cache_read_input_tokens": 3, "cache_creation_input_tokens": 4}),
        json.dumps({"type": "assistant", "message": {"content": "no usage"}}),
    ]) + "\n")
    write(os.path.join(cwd, "transcripts", "sess-2", "subagents", "agent-a00abf67871cdda3d.jsonl"),
          assistant("req-c", {"input_tokens": 100, "output_tokens": 0, "cache_read_input_tokens": 0, "cache_creation_input_tokens": 0}, {"isSidechain": True}) + "\n")

    session_env = dict(env, DUAL_NATIVE_SESSION_ID="sess-2", DUAL_NATIVE_TRANSCRIPT=transcript)
    out = run([cost, "iOS", "builder"], session_env)
    report(
        "cost labels an orchestrating session total and includes its subagents",
        out.returncode == 0 and out.stdout.strip() == "Cost: iOS · builder · total · ≥ 475 tokens · $1.23 · 1m 05s",
        "got: %r\n%s" % (out.stdout, out.stderr),
    )

    with open(transcript, "a", encoding="utf-8") as f:
        f.write(assistant("req-d", {"input_tokens": 20, "output_tokens": 5, "cache_read_input_tokens": 0, "cache_creation_input_tokens": 0}) + "\n")
    later = dict(payload, cost=dict(payload["cost"], total_cost_usd=2.0, total_api_duration_ms=125400))
    run([statusline], env, stdin=json.dumps(later))
    out = run([cost, "shared", "product"], session_env)
    report(
        "cost adds the figures since the session's previous Cost line",
        out.returncode == 0 and out.stdout.strip()
        == "Cost: shared · product · total · ≥ 500 tokens · $2.00 · 2m 05s · since the previous Cost line: ≥ 25 tokens · $0.77 · 1m 00s",
        "got: %r\n%s" % (out.stdout, out.stderr),
    )

    with open(transcript, "a", encoding="utf-8") as f:
        f.write(assistant("req-o", {"input_tokens": 7, "output_tokens": 3, "cache_read_input_tokens": 0, "cache_creation_input_tokens": 0}) + "\n")
    out = run([cost, "--orchestration"], session_env)
    report(
        "cost --orchestration labels the session total as no role's cost",
        out.returncode == 0 and out.stdout.strip()
        == "Orchestration session total, includes the role subagents; not a role cost: ≥ 510 tokens · $2.00 · 2m 05s",
        "got: %r\n%s" % (out.stdout, out.stderr),
    )
    out = run([cost, "shared", "product"], session_env)
    report(
        "cost --orchestration leaves the session's previous Cost line alone",
        out.returncode == 0 and out.stdout.strip().endswith("since the previous Cost line: ≥ 10 tokens · $0.00 · 0m 00s"),
        "got: %r\n%s" % (out.stdout, out.stderr),
    )

    hook = os.path.join(HERE, "subagent-cost-env")
    hook_payload = {
        "session_id": "sess-2",
        "transcript_path": transcript,
        "agent_id": "a00abf67871cdda3d",
        "tool_input": {"command": "framework/adapters/claude-code/cost Android reviewer"},
    }
    out = run([hook], env, stdin=json.dumps(hook_payload))
    rewritten = json.loads(out.stdout).get("hookSpecificOutput", {}).get("updatedInput", {}).get("command") if out.returncode == 0 else None
    subagent_transcript = os.path.join(cwd, "transcripts", "sess-2", "subagents", "agent-a00abf67871cdda3d.jsonl")
    report(
        "subagent Cost hook gives a Cost command the nested agent-<agent_id> transcript path",
        rewritten == "export DUAL_NATIVE_TRANSCRIPT=%s; framework/adapters/claude-code/cost Android reviewer" % subagent_transcript,
        "got: %r\\n%s" % (out.stdout, out.stderr),
    )
    bare_transcript = os.path.join(cwd, "transcripts", "sess-2", "subagents", "b00abf67871cdda3d.jsonl")
    write(bare_transcript, "")
    out = run([hook], env, stdin=json.dumps(dict(hook_payload, agent_id="b00abf67871cdda3d")))
    rewritten = json.loads(out.stdout).get("hookSpecificOutput", {}).get("updatedInput", {}).get("command") if out.returncode == 0 else None
    os.remove(bare_transcript)
    report(
        "subagent Cost hook falls back to an unprefixed <agent_id> transcript that exists",
        rewritten == "export DUAL_NATIVE_TRANSCRIPT=%s; framework/adapters/claude-code/cost Android reviewer" % bare_transcript,
        "got: %r\\n%s" % (out.stdout, out.stderr),
    )
    out = run([hook], env, stdin=json.dumps(dict(hook_payload, tool_input={"command": "echo subagent"})))
    report(
        "subagent Cost hook leaves unrelated Bash commands unchanged",
        out.returncode == 0 and not out.stdout,
        "got: %r\\n%s" % (out.stdout, out.stderr),
    )
    subagent_env = dict(env, DUAL_NATIVE_SESSION_ID="sess-2", DUAL_NATIVE_TRANSCRIPT=subagent_transcript)
    out = run([cost, "Android", "reviewer"], subagent_env)
    report(
        "cost gives a subagent only its transcript and no whole-session figures",
        out.returncode == 0 and out.stdout.strip()
        == "Cost: Android · reviewer · subagent · ≥ 100 tokens · not recorded · not recorded"
        and "only for the whole session" in out.stderr,
        "got: %r\n%s" % (out.stdout, out.stderr),
    )
    out = run([cost, "--orchestration"], subagent_env)
    report(
        "cost --orchestration refuses in a subagent",
        out.returncode == 2 and not out.stdout,
        "got: %r\n%s" % (out.stdout, out.stderr),
    )
    with open(subagent_transcript, "a", encoding="utf-8") as f:
        f.write(assistant("req-e", {"input_tokens": 4, "output_tokens": 1, "cache_read_input_tokens": 0, "cache_creation_input_tokens": 0}) + "\n")
    out = run([cost, "Android", "reviewer"], subagent_env)
    report(
        "cost compares a subagent only with its own previous Cost line",
        out.returncode == 0 and out.stdout.strip()
        == "Cost: Android · reviewer · subagent · ≥ 105 tokens · not recorded · not recorded · since the previous Cost line: ≥ 5 tokens · not recorded · not recorded",
        "got: %r\n%s" % (out.stdout, out.stderr),
    )

    out = run([cost, "shared", "product"], env)
    report(
        "cost prints not recorded for every figure without the session variables",
        out.returncode == 0 and out.stdout.strip() == "Cost: shared · product · total · not recorded · not recorded · not recorded"
        and "SessionStart" in out.stderr,
        "got: %r\n%s" % (out.stdout, out.stderr),
    )

    out = run([cost, "Android", "reviewer"], dict(env, DUAL_NATIVE_SESSION_ID="sess-none", DUAL_NATIVE_TRANSCRIPT=transcript))
    report(
        "cost records tokens from the transcript when the cache is missing",
        out.returncode == 0 and out.stdout.strip() == "Cost: Android · reviewer · total · ≥ 410 tokens · not recorded · not recorded"
        and "status line" in out.stderr,
        "got: %r\n%s" % (out.stdout, out.stderr),
    )

    out = run([cost, "ios", "builder"], session_env)
    report("cost rejects a platform or role it doesn't know", out.returncode == 2 and "usage:" in out.stderr, out.stdout + out.stderr)

    out = run([cost, "iOS", "builder"], dict(session_env, DUAL_NATIVE_TRANSCRIPT=os.path.join(cwd, "missing.jsonl")))
    report(
        "cost prints not recorded tokens when the transcript is missing",
        out.returncode == 0 and out.stdout.strip()
        == "Cost: iOS · builder · total · not recorded · $2.00 · 2m 05s · since the previous Cost line: not recorded · $0.00 · 0m 00s",
        "got: %r\n%s" % (out.stdout, out.stderr),
    )


# --- session-start ------------------------------------------------------------

def consumer_repo(root, env, name):
    """A throwaway consumer clone with the hooks and this adapter where a consumer keeps them."""
    repo = os.path.join(root, name)
    os.makedirs(repo)
    run(["git", "init", "-q", "-b", "main", repo], env, cwd=root)
    hooks = os.path.join(repo, "framework", "hooks")
    os.makedirs(hooks)
    for script in ("pre-commit", "pre-merge-commit", "install"):
        shutil.copy2(os.path.join(HOOKS_DIR, script), hooks)
    adapter = os.path.join(repo, "framework", "adapters", "claude-code")
    os.makedirs(adapter)
    shutil.copy2(os.path.join(HERE, "session-start"), adapter)
    return repo, os.path.join(adapter, "session-start")


def test_session_start(root, env):
    repo, hook = consumer_repo(root, env, "consumer")
    env_file = os.path.join(root, "claude-env")
    transcript = os.path.join(root, "transcripts", "sess-3.jsonl")
    payload = {"session_id": "sess-3", "transcript_path": transcript, "cwd": repo, "hook_event_name": "SessionStart", "source": "startup"}

    out = run([hook], dict(env, CLAUDE_ENV_FILE=env_file), stdin=json.dumps(payload), cwd=repo)
    hooks_path = run(["git", "config", "--get", "core.hooksPath"], env, cwd=repo).stdout.strip()
    exported = open(env_file, encoding="utf-8").read() if os.path.isfile(env_file) else ""
    report(
        "session-start installs the pre-commit hook and reports it in context",
        out.returncode == 0 and hooks_path == os.path.join("framework", "hooks") and "hooks active" in out.stdout,
        "hooksPath=%r\n%s%s" % (hooks_path, out.stdout, out.stderr),
    )
    report(
        "session-start exports the session id and transcript path",
        exported == "export DUAL_NATIVE_SESSION_ID=sess-3\nexport DUAL_NATIVE_TRANSCRIPT=%s\n" % transcript,
        "got: %r" % exported,
    )

    out = run([hook], dict(env, CLAUDE_ENV_FILE=env_file), stdin=json.dumps(payload), cwd=repo)
    report("session-start is idempotent on resume", out.returncode == 0 and "already active" in out.stdout, out.stdout + out.stderr)

    repo2, hook2 = consumer_repo(root, env, "consumer-own-hooks")
    run(["git", "config", "--local", "core.hooksPath", ".githooks"], env, cwd=repo2)
    out = run([hook2], dict(env, CLAUDE_ENV_FILE=os.path.join(root, "claude-env-2")), stdin=json.dumps(dict(payload, cwd=repo2)), cwd=repo2)
    report(
        "session-start reports a refused install in context without failing the hook",
        out.returncode == 0 and "NOT active" in out.stdout and "refusing" in out.stdout,
        out.stdout + out.stderr,
    )

    out = run([hook], env, stdin=json.dumps(payload), cwd=repo)
    report(
        "session-start says so when it can't export the session",
        out.returncode == 0 and "not recorded" in out.stdout,
        out.stdout + out.stderr,
    )


# --- settings.json --------------------------------------------------------------

def settings_problems(text):
    """Why `settings.json` won't work in a consumer: it doesn't parse, or a
    command or hook condition it names isn't in the framework.
    A consumer path `framework/<x>` is this repository's `<x>`."""
    try:
        settings = json.loads(text)
    except ValueError as e:
        return ["settings.json doesn't parse: %s" % e]
    if not isinstance(settings, dict):
        return ["settings.json isn't an object"]
    framework = os.path.normpath(os.path.join(HERE, "..", ".."))
    named = []  # (where, consumer path, needs to be executable)
    for event, entries in (settings.get("hooks") or {}).items():
        for entry in entries:
            for hook in entry.get("hooks", []):
                named.append(("hooks.%s command" % event, hook.get("command", "").split()[0], True))
                condition = re.match(r"^\w+\((\S+)", hook.get("if", ""))
                if condition:
                    named.append(("hooks.%s if" % event, condition.group(1), True))
    if "statusLine" in settings:
        named.append(("statusLine command", settings["statusLine"].get("command", "").split()[0], True))
    problems = []
    for where, path, executable in named:
        path = path.replace('"$CLAUDE_PROJECT_DIR"/', "")
        if path.startswith("./"):
            path = path[2:]
        if not path.startswith("framework/"):
            problems.append("%s names %r, outside framework/" % (where, path))
            continue
        full = os.path.join(framework, path[len("framework/"):])
        if not os.path.isfile(full):
            problems.append("%s names %s, which doesn't exist" % (where, path))
        elif executable and not os.access(full, os.X_OK):
            problems.append("%s names %s, which isn't executable" % (where, path))
    if not named:
        problems.append("settings.json names no command")
    return problems


def test_settings():
    with open(os.path.join(HERE, "settings.json"), encoding="utf-8") as f:
        text = f.read()
    problems = settings_problems(text)
    report("settings.json parses and every command it names exists", not problems, "\n".join(problems))
    broken = text.replace("claude-code/statusline", "claude-code/no-such-statusline")
    problems = settings_problems(broken)
    report(
        "the settings check fails on a command that doesn't exist",
        any("no-such-statusline" in p for p in problems),
        "\n".join(problems) or "no problem reported",
    )
    report("the settings check fails on JSON that doesn't parse", bool(settings_problems(text + "}")))
    settings = json.loads(text)
    pins = [key for key in ("extraKnownMarketplaces", "enabledPlugins") if key in settings]
    report("settings.json enables no plugin: the skills are a prerequisite, not a pin", not pins, ", ".join(pins))


def main():
    root = tempfile.mkdtemp(prefix="dual-native-adapter-test-")
    try:
        env = make_env(root)
        os.makedirs(env["CLAUDE_CONFIG_DIR"])
        test_statusline(root, env)
        test_cost(root, env)
        test_session_start(root, env)
        test_settings()
    finally:
        shutil.rmtree(root, ignore_errors=True)
    passed = sum(1 for ok in results if ok)
    print("%d/%d passed" % (passed, len(results)))
    return 0 if passed == len(results) else 1


if __name__ == "__main__":
    sys.exit(main())
