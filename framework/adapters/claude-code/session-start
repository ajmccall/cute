#!/usr/bin/python3
"""The Claude Code adapter's SessionStart hook.

Claude Code runs it when a session starts, resumes, clears or compacts, with
the hook's JSON on stdin (code.claude.com/docs/en/hooks). It does two things:

1. Runs the framework's `hooks/install`, so the pre-commit hook is active in
   this clone (`hooks/README.md`, Install). What the install prints goes to
   stdout, which Claude Code adds to the session's context, so the session
   sees a refusal and stops, as `hooks/README.md` says.
2. Exports the session's id and transcript path into the session's shell
   environment through `CLAUDE_ENV_FILE`, as `DUAL_NATIVE_SESSION_ID` and
   `DUAL_NATIVE_TRANSCRIPT`, so `cost` can find this session's figures even
   when several sessions run in one repository.

Always exits 0: a failed install is reported in the session's context, never
hidden behind a hook failure.
"""

import json
import os
import shlex
import subprocess
import sys

HERE = os.path.dirname(os.path.realpath(__file__))
INSTALL = os.path.normpath(os.path.join(HERE, "..", "..", "hooks", "install"))


def run_install(cwd):
    if not os.access(INSTALL, os.X_OK):
        return "session-start: %s is missing or not executable, so the pre-commit hook is NOT active." % INSTALL
    result = subprocess.run([INSTALL], cwd=cwd, capture_output=True, text=True)
    text = (result.stdout + result.stderr).strip()
    if result.returncode == 0:
        return text
    return "session-start: the pre-commit hook is NOT active. %s" % text


def export_session(payload):
    env_file = os.environ.get("CLAUDE_ENV_FILE")
    session_id = payload.get("session_id")
    if not env_file or not session_id:
        return "session-start: no CLAUDE_ENV_FILE or session_id, so `cost` will print not recorded."
    lines = ["export DUAL_NATIVE_SESSION_ID=%s\n" % shlex.quote(session_id)]
    transcript = payload.get("transcript_path")
    if transcript:
        lines.append("export DUAL_NATIVE_TRANSCRIPT=%s\n" % shlex.quote(transcript))
    try:
        with open(env_file, "a", encoding="utf-8") as f:
            f.writelines(lines)
    except OSError as error:
        return "session-start: couldn't write %s (%s), so `cost` will print not recorded." % (env_file, error)
    return None


def main():
    try:
        payload = json.load(sys.stdin)
    except ValueError:
        payload = {}
    if not isinstance(payload, dict):
        payload = {}
    cwd = payload.get("cwd") or os.getcwd()
    if not os.path.isdir(cwd):
        cwd = os.getcwd()

    print(run_install(cwd))
    note = export_session(payload)
    if note:
        print(note)
    return 0


if __name__ == "__main__":
    sys.exit(main())
