{
  "extraKnownMarketplaces": {
    "dual-native": {
      "source": {
        "source": "directory",
        "path": "./framework/adapters/claude-code"
      }
    }
  },
  "enabledPlugins": {
    "mattpocock-skills@dual-native": true,
    "mattpocock-skills@claude-plugins-official": false
  },
  "skillOverrides": {
    "code-review": "off"
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/framework/adapters/claude-code/session-start"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "if": "Bash(framework/adapters/claude-code/cost *)",
            "command": "\"$CLAUDE_PROJECT_DIR\"/framework/adapters/claude-code/subagent-cost-env"
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "\"$CLAUDE_PROJECT_DIR\"/framework/adapters/claude-code/statusline"
  }
}
