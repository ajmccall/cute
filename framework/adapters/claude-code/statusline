#!/usr/bin/python3
"""The Claude Code adapter's status line command.

Claude Code runs it every few seconds with the status line JSON on stdin
(code.claude.com/docs/en/statusline). The status line is the only place
Claude Code reports a running session's cost, so this command:

1. Saves the session's cost block to the cost cache,
   `~/.cache/dual-native/claude-code/<session id>.json`, on every refresh.
   `cost` reads it when the session writes its handoff entry.
2. Prints the status line. If `<Claude config dir>/dual-native-statusline`
   exists and is executable (`~/.claude/dual-native-statusline`, or under
   `CLAUDE_CONFIG_DIR` when that is set), it gets the same JSON on stdin and
   its output is printed, so each person keeps their own display. Otherwise
   a default line: folder | branch* | model | context % | $cost.

Never fails: any error falls back to the default line, or to nothing.
"""

import json
import os
import subprocess
import sys
import time

CACHE_DIR = os.path.join(
    os.environ.get("XDG_CACHE_HOME") or os.path.join(os.path.expanduser("~"), ".cache"),
    "dual-native",
    "claude-code",
)
CONFIG_DIR = os.environ.get("CLAUDE_CONFIG_DIR") or os.path.join(os.path.expanduser("~"), ".claude")
PASSTHROUGH = os.path.join(CONFIG_DIR, "dual-native-statusline")

SAVED_KEYS = ("session_id", "version", "model", "cost", "context_window", "transcript_path")


def save(payload):
    session_id = payload.get("session_id")
    if not session_id or not isinstance(session_id, str) or os.sep in session_id:
        return
    record = {key: payload.get(key) for key in SAVED_KEYS}
    record["cwd"] = (payload.get("workspace") or {}).get("current_dir")
    record["saved_at"] = time.time()
    os.makedirs(CACHE_DIR, exist_ok=True)
    path = os.path.join(CACHE_DIR, session_id + ".json")
    tmp = "%s.%d.tmp" % (path, os.getpid())
    with open(tmp, "w", encoding="utf-8") as f:
        json.dump(record, f)
    os.replace(tmp, path)


def git(cwd, *args):
    try:
        out = subprocess.run(
            ["git", "-C", cwd, *args], capture_output=True, text=True, timeout=2
        )
    except (OSError, subprocess.SubprocessError):
        return None
    return out.stdout if out.returncode == 0 else None


def default_line(payload):
    cwd = (payload.get("workspace") or {}).get("current_dir") or os.getcwd()
    parts = [os.path.basename(cwd.rstrip(os.sep)) or cwd]
    branch = git(cwd, "branch", "--show-current")
    if branch is not None and branch.strip():
        dirty = "*" if (git(cwd, "status", "--porcelain", "--untracked-files=no") or "").strip() else ""
        parts.append(branch.strip() + dirty)
    model = (payload.get("model") or {}).get("display_name")
    if model:
        parts.append(model)
    used = (payload.get("context_window") or {}).get("used_percentage")
    if isinstance(used, (int, float)):
        parts.append("%d%%" % int(used))
    dollars = (payload.get("cost") or {}).get("total_cost_usd")
    if isinstance(dollars, (int, float)):
        parts.append("$%.2f" % dollars)
    return " | ".join(parts)


def passthrough(raw):
    if not os.access(PASSTHROUGH, os.X_OK):
        return None
    try:
        out = subprocess.run([PASSTHROUGH], input=raw, capture_output=True, text=True, timeout=5)
    except (OSError, subprocess.SubprocessError):
        return None
    if out.returncode != 0:
        return None
    return out.stdout.rstrip("\n")


def main():
    raw = sys.stdin.read()
    try:
        payload = json.loads(raw)
    except ValueError:
        payload = {}
    if not isinstance(payload, dict):
        payload = {}
    try:
        save(payload)
    except (OSError, TypeError, ValueError):
        pass
    line = passthrough(raw)
    if line is None:
        try:
            line = default_line(payload)
        except Exception:  # the status line must never fail
            line = ""
    print(line)
    return 0


if __name__ == "__main__":
    sys.exit(main())
