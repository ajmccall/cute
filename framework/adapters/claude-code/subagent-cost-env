#!/usr/bin/python3
"""Give a Claude Code subagent's Cost command its own transcript path.

Claude Code's PreToolUse hook supplies the parent transcript path even when a
subagent runs the Bash tool. It does supply that subagent's agent_id, so this
hook rewrites the pending Bash command to export the nested transcript path,
`<session>/subagents/agent-<agent_id>.jsonl` (or `<agent_id>.jsonl` where only
that file exists), for that command only. The `cost` command then recognises
the path as a subagent transcript and reports its own tokens.

The hook changes nothing for the orchestrating session, malformed hook input,
or an agent id/path that cannot safely name a nested transcript.
"""

import json
import os
import shlex
import sys

COST_COMMAND = "framework/adapters/claude-code/cost"


def is_cost_command(command):
    try:
        words = shlex.split(command)
    except ValueError:
        return False
    return any(word == COST_COMMAND or word.endswith("/" + COST_COMMAND) for word in words)


def subagent_transcript(payload):
    transcript = payload.get("transcript_path")
    agent_id = payload.get("agent_id")
    if not isinstance(transcript, str) or not transcript.endswith(".jsonl"):
        return None
    if not isinstance(agent_id, str) or not agent_id or agent_id in (".", "..") or os.sep in agent_id:
        return None
    folder = os.path.join(transcript[:-6], "subagents")
    prefixed = os.path.join(folder, "agent-" + agent_id + ".jsonl")
    bare = os.path.join(folder, agent_id + ".jsonl")
    if not os.path.exists(prefixed) and os.path.exists(bare):
        return bare
    return prefixed


def main():
    try:
        payload = json.load(sys.stdin)
    except ValueError:
        return 0
    if not isinstance(payload, dict):
        return 0
    command = (payload.get("tool_input") or {}).get("command")
    transcript = subagent_transcript(payload)
    if not isinstance(command, str) or not is_cost_command(command) or not transcript:
        return 0
    print(json.dumps({
        "hookSpecificOutput": {
            "hookEventName": "PreToolUse",
            "updatedInput": {
                "command": "export DUAL_NATIVE_TRANSCRIPT=%s; %s" % (shlex.quote(transcript), command),
            },
        },
    }))
    return 0


if __name__ == "__main__":
    sys.exit(main())
