#!/usr/bin/python3
"""Self-test for the pi adapter. Run it after any change in this folder:

    framework/adapters/pi/test

It needs no pi install. It checks that the settings point at the extension
and name no package, the extension's dollar sum (with node, when `node` is
on the PATH), and the `cost` command against a session file it writes. Exit 0 when every check passes.
"""

import json
import os
import shutil
import subprocess
import sys
import tempfile

HERE = os.path.dirname(os.path.realpath(__file__))
FRAMEWORK = os.path.normpath(os.path.join(HERE, "..", ".."))
COST = os.path.join(HERE, "cost")
EXTENSION = os.path.join(HERE, "dual-native.js")
failures = []


def report(name, ok, detail=""):
    print("%s  %s%s" % ("ok  " if ok else "FAIL", name, "" if ok else ": %s" % detail))
    if not ok:
        failures.append(name)


def read(*parts):
    with open(os.path.join(FRAMEWORK, *parts), encoding="utf-8") as f:
        return f.read()


def check_settings():
    settings = json.loads(read("adapters", "pi", "settings.json"))
    report("settings.json lists no package: the skills are a prerequisite, not a pin", "packages" not in settings, settings.get("packages"))
    extensions = settings.get("extensions", [])
    # Paths in .pi/settings.json resolve from the project's .pi folder.
    resolved = [os.path.normpath(os.path.join(FRAMEWORK, "..", ".pi", e)) for e in extensions]
    expected = os.path.normpath(os.path.join(FRAMEWORK, "..", "framework", "adapters", "pi", "dual-native.js"))
    report("settings.json loads the extension from framework/", resolved == [expected], extensions)


EXTENSION_CHECKS = r"""
const m = await import(process.argv[1]);
const dollars = m.sessionDollars([
  {type: "message", message: {role: "assistant", usage: {cost: {total: 1.25}}}},
  {type: "message", message: {role: "user"}},
  {type: "compaction", usage: {cost: {total: 0.5}}},
]);
console.log(JSON.stringify({dollars}));
"""


def check_extension():
    node = shutil.which("node")
    if not node:
        print("skip  extension checks: no node on the PATH")
        return
    syntax = subprocess.run([node, "--check", EXTENSION], capture_output=True, text=True)
    report("the extension parses", syntax.returncode == 0, syntax.stderr.strip())
    run = subprocess.run([node, "--input-type=module", "-e", EXTENSION_CHECKS, "file://" + EXTENSION],
                         capture_output=True, text=True)
    if run.returncode != 0:
        report("the extension's checks run", False, run.stderr.strip())
        return
    out = json.loads(run.stdout)
    report("the footer sums assistant and compaction dollars", abs(out["dollars"] - 1.75) < 1e-9, out["dollars"])


def entry(kind, **fields):
    return json.dumps(dict(type=kind, **fields)) + "\n"


def assistant(tokens, dollars):
    usage = {"input": tokens[0], "output": tokens[1], "cacheRead": tokens[2], "cacheWrite": tokens[3],
             "totalTokens": sum(tokens), "cost": {"total": dollars}}
    return entry("message", message={"role": "assistant", "usage": usage})


def cost(args, env):
    return subprocess.run([COST] + args, capture_output=True, text=True, env=env)


def check_cost():
    tmp = tempfile.mkdtemp()
    try:
        session = os.path.join(tmp, "s.jsonl")
        with open(session, "w", encoding="utf-8") as f:
            f.write(entry("session", version=3, id="test-session"))
            f.write(entry("message", message={"role": "user", "content": "hi"}))
            f.write(assistant((1000, 200, 5000, 300), 1.234))
            f.write("not json\n")
            f.write(entry("compaction", usage={"input": 500, "output": 100, "cacheRead": 0, "cacheWrite": 0, "cost": {"total": 0.1}}))
        env = dict(os.environ, PI_SESSION_FILE=session, XDG_CACHE_HOME=os.path.join(tmp, "cache"))
        env.pop("PI_SESSION_ID", None)

        out = cost(["iOS", "builder"], env)
        report("cost prints the first line", out.stdout.strip() == "Cost: iOS · builder · 7,100 tokens · $1.33 · not recorded",
               out.stdout.strip() or out.stderr.strip())

        with open(session, "a", encoding="utf-8") as f:
            f.write(assistant((100, 50, 0, 0), 0.5))
        out = cost(["iOS", "builder"], env)
        report("cost adds the figures since the previous line",
               out.stdout.strip() == "Cost: iOS · builder · 7,250 tokens · $1.83 · not recorded · "
                                     "since the previous Cost line: 150 tokens · $0.50 · not recorded",
               out.stdout.strip() or out.stderr.strip())

        bare = dict(env)
        bare.pop("PI_SESSION_FILE")
        out = cost(["shared", "product"], bare)
        report("cost without a session file prints not recorded",
               out.returncode == 0 and out.stdout.strip() == "Cost: shared · product · not recorded · not recorded · not recorded"
               and "PI_SESSION_FILE" in out.stderr, out.stdout + out.stderr)

        out = cost(["web", "builder"], env)
        report("cost refuses a bad platform", out.returncode == 2, out.returncode)
    finally:
        shutil.rmtree(tmp, ignore_errors=True)


def main():
    check_settings()
    check_extension()
    check_cost()
    print("\n%d failed" % len(failures) if failures else "\nall passed")
    return 1 if failures else 0


if __name__ == "__main__":
    sys.exit(main())
