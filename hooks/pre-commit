#!/usr/bin/python3
"""The framework's pre-commit hook.

Four checks on the staged content, each finishing in seconds:

1. Whitespace: git's own `diff --cached --check`.
2. Schema: each staged feature file in the app schema folder has the nine
   fixed sections in order, a well-formed States section, and well-formed,
   unique criterion IDs whose cross-feature citations resolve.
3. Boundary search: when `framework/` or `AGENTS.md` is staged, the whole
   staged `framework/` tree is searched for the product's terms and paths.
   A path counts only if it has a `/`, and only as a whole path: at the
   start of a line or after whitespace, a backtick, a quote or an opening
   bracket.
4. (The install command is checked separately: see `install`.)

The hook reads the consumer contract, `AGENTS.md` at the repository root:
the App schema row and the other paths in Where things live, skipping a
cell still in its template `<…>` form, and the Boundary terms line in App
settings. Without an `AGENTS.md` (the framework's
own repository), only the whitespace check runs.

Everything is read from the index, never from the working tree.

`pre-commit --range <base>` runs the same checks on a finished change
instead: the paths that `<base>...HEAD` changes, read from `HEAD`, as if
the whole change were staged at once.
"""

import os
import re
import subprocess
import sys

SCHEMA_HEADINGS = [
    "Data",
    "States",
    "Screens and surfaces",
    "Component roles",
    "Interface text",
    "Deliberate platform differences",
    "Non-goals",
    "Links to other features",
    "Acceptance criteria",
]

STATE_MACHINE_HEADER = re.compile(r"^\*\*[^*]+\.\*\* States:")
STATE_TABLE_HEADER = re.compile(
    r"^\|\s*From\s*\|\s*Event\s*\|\s*Guard\s*\|\s*To\s*\|\s*Effect\s*\|"
)
NO_LIFECYCLE = re.compile(r"^No lifecycle:")
CRITERION = re.compile(r"^- \*\*C(\d+)\.\*\* \S")
CITATION = re.compile(r"\b([a-z0-9]+(?:-[a-z0-9]+)*)#C(\d+)\b")
BACKTICKED = re.compile(r"`([^`]+)`")
BOUNDARY_TERMS = re.compile(r"^\s*(?:[-*]\s*)?\*\*Boundary terms:?\*\*:?\s*(.*)$")
HEADING2 = re.compile(r"^## (.*)$")
PLACEHOLDER = re.compile(r"^<.*>$")

problems = []

# None: check the index. A commit: check `<base>...HEAD`, read from HEAD.
range_base = None


def problem(check, where, message):
    problems.append("pre-commit: %s: %s: %s" % (check, where, message))


def git(*args, **kwargs):
    return subprocess.run(["git", *args], capture_output=True, text=True, **kwargs)


def diff_against():
    """`git diff` arguments for the change being checked."""
    return ["--cached"] if range_base is None else [range_base + "...HEAD"]


def staged_paths():
    out = git("diff", *diff_against(), "--name-only", "--diff-filter=ACMR", "-z")
    return [p for p in out.stdout.split("\0") if p]


def index_text(path):
    """The staged content of `path` (in range mode, its content at HEAD), or
    None when it isn't there or isn't text."""
    rev = "" if range_base is None else "HEAD"
    out = subprocess.run(
        ["git", "show", rev + ":" + path], capture_output=True
    )
    if out.returncode != 0:
        return None
    try:
        return out.stdout.decode("utf-8")
    except UnicodeDecodeError:
        return None


def index_paths(prefix):
    if range_base is None:
        out = git("ls-files", "--cached", "-z", "--", prefix)
    else:
        out = git("ls-tree", "-r", "--name-only", "-z", "HEAD", "--", prefix)
    return [p for p in out.stdout.split("\0") if p]


def strip_fences(lines):
    """Lines with fenced code blocks blanked, so headings inside them don't
    count. Keeps line numbers."""
    result = []
    fenced = False
    for line in lines:
        if line.strip().startswith("```"):
            fenced = not fenced
            result.append("")
            continue
        result.append("" if fenced else line)
    return result


# --- consumer contract -------------------------------------------------------


class Contract:
    def __init__(self):
        self.schema_dir = None
        self.paths = []
        self.terms = None  # None: no line; []: empty line


def read_contract(text, framework_prefix):
    contract = Contract()
    lines = strip_fences(text.splitlines())
    section = None
    for line in lines:
        heading = HEADING2.match(line)
        if heading:
            section = heading.group(1).strip().lower()
            continue
        m = BOUNDARY_TERMS.match(line)
        if m:
            contract.terms = [t.strip() for t in m.group(1).split(",") if t.strip()]
            continue
        if section == "where things live" and line.startswith("|"):
            cells = [c.strip() for c in line.strip().strip("|").split("|")]
            if len(cells) < 2 or set(cells[0]) <= set("-: "):
                continue
            what, where = cells[0].lower(), cells[1]
            if PLACEHOLDER.match(where):
                # Still the template's `<…>` text: its examples aren't paths.
                continue
            found = [p.strip("/") + ("/" if p.endswith("/") else "") for p in BACKTICKED.findall(where)]
            if what == "app schema" and found:
                contract.schema_dir = found[0].rstrip("/")
            for p in found:
                if p.startswith(framework_prefix) and framework_prefix:
                    continue
                if p and p not in contract.paths:
                    contract.paths.append(p)
    return contract


# --- check 1: whitespace -----------------------------------------------------


def check_whitespace():
    out = git("diff", *diff_against(), "--check")
    if out.returncode != 0:
        for line in out.stdout.splitlines():
            if line.strip():
                problem("whitespace", line.split(":", 1)[0] if ":" in line else "-", line)


# --- check 2: schema ---------------------------------------------------------


def sections_of(lines):
    """Map heading text -> (line number of heading, body lines) for `##`
    headings, plus their order."""
    order = []
    bodies = {}
    current = None
    for n, line in enumerate(lines, 1):
        m = HEADING2.match(line)
        if m:
            current = m.group(1).strip()
            order.append((current, n))
            bodies[current] = []
            continue
        if current is not None:
            bodies[current].append((n, line))
    return order, bodies


def criterion_ids(lines):
    """IDs under Acceptance criteria, as (number, line number); and the
    bullets there that aren't well-formed."""
    _, bodies = sections_of(lines)
    ids, bad = [], []
    for n, line in bodies.get("Acceptance criteria", []):
        if not line.startswith("- "):
            continue
        m = CRITERION.match(line)
        if m:
            ids.append((int(m.group(1)), n))
        else:
            bad.append(n)
    return ids, bad


def check_feature_file(path, text, schema_dir, cache):
    lines = strip_fences(text.splitlines())
    order, bodies = sections_of(lines)
    names = [name for name, _ in order]
    if names != SCHEMA_HEADINGS:
        expected = ", ".join(SCHEMA_HEADINGS)
        if sorted(names) == sorted(SCHEMA_HEADINGS):
            problem("schema", path, "the ## sections are out of order; expected: %s" % expected)
        else:
            missing = [h for h in SCHEMA_HEADINGS if h not in names]
            extra = [h for h in names if h not in SCHEMA_HEADINGS]
            parts = []
            if missing:
                parts.append("missing: " + ", ".join(missing))
            if extra:
                parts.append("unexpected: " + ", ".join(extra))
            problem("schema", path, "## sections %s (schema-template.md lists the nine)" % "; ".join(parts))

    states = [(n, l) for n, l in bodies.get("States", []) if l.strip()]
    if "States" in bodies:
        has_no_lifecycle = any(NO_LIFECYCLE.match(l.strip()) for _, l in states)
        headers = [n for n, l in states if STATE_MACHINE_HEADER.match(l.strip())]
        tables = [n for n, l in states if STATE_TABLE_HEADER.match(l.strip())]
        if not has_no_lifecycle and not headers:
            where = "%s:%d" % (path, states[0][0]) if states else path
            problem(
                "schema", where,
                'States must hold a "No lifecycle: <reason>" line or a state machine '
                '("**<Name>.** States: ... Initial: ..." then a From/Event/Guard/To/Effect table)',
            )
        elif headers and len(tables) < len(headers):
            problem(
                "schema", "%s:%d" % (path, headers[0]),
                "each state machine needs a | From | Event | Guard | To | Effect | table",
            )

    ids, bad = criterion_ids(lines)
    for n in bad:
        problem("schema", "%s:%d" % (path, n), 'each criterion starts "- **C<n>.** "')
    seen = {}
    for number, n in ids:
        if number in seen:
            problem("schema", "%s:%d" % (path, n), "criterion ID C%d is also on line %d" % (number, seen[number]))
        else:
            seen[number] = n

    own = os.path.splitext(os.path.basename(path))[0]
    for n, line in enumerate(lines, 1):
        for feature, number in CITATION.findall(line):
            target = "%s/%s.md" % (schema_dir, feature)
            if feature == own:
                target_ids = set(seen)
            else:
                if target not in cache:
                    target_text = index_text(target)
                    cache[target] = None if target_text is None else {
                        num for num, _ in criterion_ids(strip_fences(target_text.splitlines()))[0]
                    }
                target_ids = cache[target]
                if target_ids is None:
                    problem("schema", "%s:%d" % (path, n), "%s#C%s cites a feature file that isn't in the index: %s" % (feature, number, target))
                    continue
            if int(number) not in target_ids:
                problem("schema", "%s:%d" % (path, n), "%s#C%s cites a criterion that doesn't exist" % (feature, number))


def check_schema(staged, contract):
    if not contract.schema_dir:
        sys.stderr.write("pre-commit: AGENTS.md's App schema row has no backticked path; schema check skipped\n")
        return
    prefix = contract.schema_dir + "/"
    cache = {}
    for path in staged:
        if not path.startswith(prefix) or not path.endswith(".md"):
            continue
        if os.path.basename(path) == "README.md":
            continue
        text = index_text(path)
        if text is None:
            continue
        check_feature_file(path, text, contract.schema_dir, cache)


# --- check 3: boundary search -----------------------------------------------


def check_boundary(framework_prefix, contract):
    if contract.terms is None:
        problem("boundary", "AGENTS.md", 'no "**Boundary terms:**" line under App settings (agents-template.md)')
        return
    patterns = []
    for term in contract.terms:
        # Never inside another word: a term that ends "execute" isn't the product there.
        patterns.append((term, re.compile(r"(?<![A-Za-z])" + re.escape(term), re.IGNORECASE)))
    for p in contract.paths:
        if "/" not in p:
            # A bare filename, which the framework may name as its own.
            continue
        # Only as a whole path, never as the tail of a longer name.
        patterns.append((p, re.compile(r"(^|[\s`'\"(\[{])" + re.escape(p), re.IGNORECASE)))
    if not patterns:
        problem("boundary", "AGENTS.md", "Boundary terms line lists no terms")
        return
    for path in index_paths(framework_prefix):
        text = index_text(path)
        if text is None:
            continue
        for n, line in enumerate(text.splitlines(), 1):
            for label, pattern in patterns:
                if pattern.search(line):
                    problem("boundary", "%s:%d" % (path, n), "names the product or its paths: %r" % label)


# --- main --------------------------------------------------------------------


def main(args):
    global range_base
    if args[:1] == ["--range"] and len(args) == 2:
        range_base = args[1]
    elif args:
        sys.stderr.write("usage: pre-commit [--range <base>]\n")
        return 2
    top = git("rev-parse", "--show-toplevel")
    if top.returncode != 0:
        sys.stderr.write("pre-commit: not inside a git repository\n")
        return 1
    if range_base is not None and git("rev-parse", "--verify", "-q", range_base + "^{commit}").returncode != 0:
        sys.stderr.write("pre-commit: --range: %s isn't a commit\n" % range_base)
        return 2
    top = os.path.realpath(top.stdout.strip())
    os.chdir(top)
    hooks_dir = os.path.dirname(os.path.realpath(__file__))
    framework_dir = os.path.relpath(os.path.dirname(hooks_dir), top)
    framework_prefix = "" if framework_dir == "." else framework_dir + "/"

    staged = staged_paths()
    check_whitespace()

    # The contract as staged. An untracked AGENTS.md isn't a contract yet.
    contract_text = index_text("AGENTS.md")
    if contract_text is not None and framework_prefix:
        contract = read_contract(contract_text, framework_prefix)
        check_schema(staged, contract)
        if any(p.startswith(framework_prefix) for p in staged) or "AGENTS.md" in staged:
            check_boundary(framework_prefix, contract)

    if problems:
        for line in problems:
            sys.stderr.write(line + "\n")
        if range_base is not None:
            sys.stderr.write(
                "pre-commit: %d problem%s in %s...HEAD.\n"
                % (len(problems), "" if len(problems) == 1 else "s", range_base)
            )
            return 1
        sys.stderr.write(
            "pre-commit: %d problem%s. Fix them and commit again. A human may allow "
            "`git commit --no-verify`; the message then needs a `Hook-bypassed: <reason>` "
            "trailer, and the commit counts as a correction (process.md, Local checks).\n"
            % (len(problems), "" if len(problems) == 1 else "s")
        )
        return 1
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
