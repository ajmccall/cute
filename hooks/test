#!/usr/bin/python3
"""Self-test for the framework's pre-commit hook and install command.

Builds throwaway git repositories in a temp folder, copies this hooks folder
into them as a consumer would have it (`framework/hooks/`), installs the hook
and commits fixtures that must pass and must fail. Run it by hand after any
change to `hooks/` and show its output on the change request:

    framework/hooks/test

Exit 0 when every case passes.
"""

import os
import re
import shutil
import subprocess
import sys
import tempfile
import textwrap

HOOKS_DIR = os.path.dirname(os.path.realpath(__file__))

results = []


def report(name, ok, detail=""):
    results.append(ok)
    print("%s  %s%s" % ("PASS" if ok else "FAIL", name, ("\n      " + detail.strip().replace("\n", "\n      ")) if detail and not ok else ""))


class Repo:
    def __init__(self, root, framework_prefix="framework"):
        self.root = root
        self.env = {
            k: v for k, v in os.environ.items()
            if not k.startswith("GIT_") and k != "HOME"
        }
        self.env["HOME"] = root  # no user gitconfig
        self.env["PYTHONDONTWRITEBYTECODE"] = "1"
        self.env["GIT_CONFIG_NOSYSTEM"] = "1"
        self.env["GIT_CONFIG_GLOBAL"] = os.devnull
        os.makedirs(root)
        self.run("git", "init", "-q", "-b", "main", root)
        self.run("git", "config", "user.name", "Test")
        self.run("git", "config", "user.email", "test@example.invalid")
        self.hooks = os.path.join(root, framework_prefix, "hooks") if framework_prefix else os.path.join(root, "hooks")
        # The hook and its install, not this test: its fixture terms would trip
        # the boundary search in the fixture repository.
        os.makedirs(self.hooks)
        for name in ("pre-commit", "pre-merge-commit", "install"):
            shutil.copy2(os.path.join(HOOKS_DIR, name), self.hooks)

    def run(self, *cmd, check=False):
        out = subprocess.run(cmd, cwd=self.root, env=self.env, capture_output=True, text=True)
        if check and out.returncode != 0:
            raise RuntimeError("%s failed:\n%s%s" % (" ".join(cmd), out.stdout, out.stderr))
        return out

    def write(self, path, text):
        full = os.path.join(self.root, path)
        os.makedirs(os.path.dirname(full), exist_ok=True)
        with open(full, "w", encoding="utf-8") as f:
            f.write(textwrap.dedent(text).lstrip("\n"))

    def commit(self, message="fixture"):
        self.run("git", "add", "-A", check=True)
        return self.run("git", "commit", "-q", "-m", message)

    def discard(self):
        self.run("git", "reset", "-q", "--hard", check=True)
        self.run("git", "clean", "-qfd", check=True)

    def install(self):
        return self.run(os.path.join(self.hooks, "install"))


# --- fixtures ---------------------------------------------------------------

AGENTS = """
# Example agents file

## Where things live

| What | Path |
|---|---|
| App schema | `schema-zq/` |
| Product brief | `zq-notes/brief.md` |
| iOS app | `zq-apps/ios/` |
| Android app | `zq-apps/android/` |
| iOS convention reference | `framework/conventions/ios.md` |
| Tracker | GitHub Issues on `example/zebraphone` |

## App settings

- **App identifier:** `md.example.zebraphone`
- **Boundary terms:** Zebraphone, zebra call
"""

AGENTS_NO_TERMS = AGENTS.replace("- **Boundary terms:** Zebraphone, zebra call\n", "")

FEATURE = """
# Calling

A person can place a call.

## Data

None

## States

No lifecycle: the screen only shows saved data.

## Screens and surfaces

None

## Component roles

None

## Interface text

None

## Deliberate platform differences

None

## Non-goals

- Video

## Links to other features

None

## Acceptance criteria

- **C1.** When the call button is pressed, the app shall place the call.
- **C2.** While a call is active, the app shall show its duration.
"""

STATE_MACHINE = """
**Call.** States: idle, ringing, active. Initial: idle.

| From | Event | Guard | To | Effect |
|---|---|---|---|---|
| idle | call pressed | — | ringing | — |
| ringing | answered | — | active | start timer |
"""

CONTACTS = """
# Contacts

A person can see who they can call.

## Data

None

## States

No lifecycle: a list of saved data.

## Screens and surfaces

None

## Component roles

None

## Interface text

None

## Deliberate platform differences

None

## Non-goals

None

## Links to other features

- `calling#C1`: a contact row places the call.

## Acceptance criteria

- **C1.** The app shall list contacts by name.
"""

FRAMEWORK_DOC = """
# Process

Every role reads this first. It names iOS, Android and SwiftUI freely.
The consumer contract lists the project's own paths.
"""


def expect(name, out, fail, needle=None):
    ok = (out.returncode != 0) == fail
    if ok and needle is not None:
        ok = needle in (out.stdout + out.stderr)
    report(name, ok, "exit %d\n%s%s" % (out.returncode, out.stdout, out.stderr))


def main():
    base = tempfile.mkdtemp(prefix="framework-hooks-test-")
    try:
        # --- install -----------------------------------------------------
        repo = Repo(os.path.join(base, "consumer"))
        expect("install sets core.hooksPath", repo.install(), fail=False, needle="hooks active")
        hooks_path = repo.run("git", "config", "--get", "core.hooksPath").stdout.strip()
        report("install records a relative path", hooks_path == "framework/hooks", hooks_path)
        expect("install is idempotent", repo.install(), fail=False, needle="already active")

        other = Repo(os.path.join(base, "other-hooks"))
        other.run("git", "config", "core.hooksPath", ".githooks", check=True)
        expect("install refuses another hooks path", other.install(), fail=True, needle="refusing")

        missing = Repo(os.path.join(base, "missing-merge-hook"))
        os.chmod(os.path.join(missing.hooks, "pre-merge-commit"), 0o644)
        expect("install rejects non-executable merge hook", missing.install(), fail=True, needle="pre-merge-commit")

        # --- first commit: contract + framework + schema, all clean --------
        repo.write("AGENTS.md", AGENTS)
        repo.write("framework/process.md", FRAMEWORK_DOC)
        repo.write("schema-zq/README.md", "# App schema\n\n## Features\n\n- [Calling](calling.md): place calls\n")
        repo.write("schema-zq/calling.md", FEATURE)
        expect("clean first commit passes", repo.commit("first"), fail=False)

        # --- clean merge commits -----------------------------------------
        repo.run("git", "checkout", "-q", "-b", "leak", check=True)
        repo.write("framework/leak.md", "Zebraphone leaked here.\n")
        repo.run("git", "add", "-A", check=True)
        repo.run("git", "-c", "core.hooksPath=/dev/null", "commit", "-q", "-m", "source", check=True)
        repo.run("git", "checkout", "-q", "main", check=True)
        repo.write("main-only.md", "Main side.\n")
        expect("merge fixture diverges", repo.commit("main side"), fail=False)
        before = repo.run("git", "rev-parse", "HEAD", check=True).stdout.strip()
        out = repo.run("git", "merge", "--no-ff", "-m", "merge leak", "leak")
        expect("clean merge with product term is rejected", out, fail=True, needle="'Zebraphone'")
        report("rejected merge leaves HEAD unchanged", repo.run("git", "rev-parse", "HEAD", check=True).stdout.strip() == before)
        repo.run("git", "merge", "--abort", check=True)
        repo.run("git", "checkout", "-q", "-b", "clean-merge", check=True)
        repo.write("framework/clean.md", "Generic process.\n")
        expect("clean merge source commits", repo.commit("clean source"), fail=False)
        repo.run("git", "checkout", "-q", "main", check=True)
        expect("clean merge passes", repo.run("git", "merge", "--no-ff", "-m", "merge clean", "clean-merge"), fail=False)
        parents = repo.run("git", "rev-list", "--parents", "-n", "1", "HEAD", check=True).stdout.split()
        report("clean merge creates a merge commit", len(parents) == 3)

        # --- whitespace --------------------------------------------------
        repo.write("zq-notes/brief.md", "# Brief\n\nTrailing space here. \n")
        expect("trailing whitespace fails", repo.commit(), fail=True, needle="whitespace")
        repo.discard()

        # --- schema ------------------------------------------------------
        repo.write("schema-zq/calling.md", FEATURE.replace("## Non-goals\n\n- Video\n\n", ""))
        expect("missing section fails", repo.commit(), fail=True, needle="missing: Non-goals")
        repo.discard()

        swapped = FEATURE.replace("## Data\n\nNone\n\n## States\n\nNo lifecycle: the screen only shows saved data.\n",
                                  "## States\n\nNo lifecycle: the screen only shows saved data.\n\n## Data\n\nNone\n")
        repo.write("schema-zq/calling.md", swapped)
        expect("sections out of order fail", repo.commit(), fail=True, needle="out of order")
        repo.discard()

        repo.write("schema-zq/calling.md", FEATURE.replace("No lifecycle: the screen only shows saved data.", "None"))
        expect("States with neither form fails", repo.commit(), fail=True, needle="States must hold")
        repo.discard()

        repo.write("schema-zq/calling.md", FEATURE.replace("No lifecycle: the screen only shows saved data.\n", STATE_MACHINE.lstrip("\n")))
        expect("state machine passes", repo.commit(), fail=False)

        no_table = STATE_MACHINE.lstrip("\n").split("\n")[0] + "\n"
        repo.write("schema-zq/calling.md", FEATURE.replace("No lifecycle: the screen only shows saved data.\n", no_table))
        expect("state machine without its table fails", repo.commit(), fail=True, needle="table")
        repo.discard()

        repo.write("schema-zq/calling.md", FEATURE.replace("**C2.**", "**C1.**"))
        expect("duplicate criterion ID fails", repo.commit(), fail=True, needle="C1 is also on line")
        repo.discard()

        repo.write("schema-zq/calling.md", FEATURE.replace("- **C2.** While", "- C2. While"))
        expect("malformed criterion fails", repo.commit(), fail=True, needle='starts "- **C<n>.** "')
        repo.discard()

        repo.write("schema-zq/contacts.md", CONTACTS)
        expect("citation of an existing criterion passes", repo.commit(), fail=False)

        repo.write("schema-zq/contacts.md", CONTACTS.replace("calling#C1", "calling#C9"))
        expect("citation of a missing criterion fails", repo.commit(), fail=True, needle="calling#C9 cites a criterion that doesn't exist")
        repo.discard()

        repo.write("schema-zq/contacts.md", CONTACTS.replace("calling#C1", "dialler#C1"))
        expect("citation of a missing feature fails", repo.commit(), fail=True, needle="isn't in the index")
        repo.discard()

        repo.write("schema-zq/README.md", "# App schema\n\nNot a feature file, so not checked.\n")
        expect("the index file isn't checked as a feature", repo.commit(), fail=False)

        repo.write("zq-apps/ios/README.md", "# iOS\n\nFake headings here: ## Whatever\n")
        expect("files outside the schema folder aren't schema-checked", repo.commit(), fail=False)

        # --- boundary ----------------------------------------------------
        repo.write("framework/process.md", FRAMEWORK_DOC + "\nZebraphone shows a badge.\n")
        expect("product term in framework/ fails", repo.commit(), fail=True, needle="'Zebraphone'")
        repo.discard()

        repo.write("framework/process.md", FRAMEWORK_DOC + "\nThe ZEBRA CALL screen.\n")
        expect("term matches case-insensitively", repo.commit(), fail=True, needle="'zebra call'")
        repo.discard()

        for name, text, fail in [
            ("a term inside another word passes", "The okazebraphone ships.", False),
            ("a term at the start of an identifier fails", "Call `ZebraphoneBoardView` here.", True),
            ("a term after an underscore fails", "Name it zq_zebraphone_board.", True),
            ("a term after a hyphen fails", "The zq-zebraphone module.", True),
            ("a term at the start of a line fails", "zebraphone first.", True),
            # The known gap: camelCase after a letter isn't searched.
            ("a term after a letter in camelCase passes", "Set isZebraphone to true.", False),
        ]:
            repo.write("framework/process.md", FRAMEWORK_DOC + "\n" + text + "\n")
            out = repo.commit()
            expect(name, out, fail=fail, needle="'Zebraphone'" if fail else None)
            if out.returncode == 0:
                repo.run("git", "reset", "-q", "--hard", "HEAD~1", check=True)
            repo.discard()

        repo.write("framework/process.md", FRAMEWORK_DOC + "\nSee zq-notes/brief.md for the purpose.\n")
        expect("project path in framework/ fails", repo.commit(), fail=True, needle="'zq-notes/brief.md'")
        repo.discard()

        repo.write("framework/process.md", FRAMEWORK_DOC + "\nSee https://example.com/x/zq-notes/brief.md for the purpose.\n")
        expect("path inside a URL passes", repo.commit(), fail=False)

        repo.write("framework/process.md", FRAMEWORK_DOC + "\nSee framework/conventions/ios.md.\n")
        expect("framework's own paths pass", repo.commit(), fail=False)

        # Paths a project might well have. Built here, not written out, so
        # that this file never trips a consumer whose own paths they are.
        spec, app, ios = "spec" + "/", "app" + "/", "ios" + "/"
        short = AGENTS.replace("| Tracker |", "| Specs | `%s` |\n| App module | `%s` |\n| Mobile | `%s` |\n| Tracker |" % (spec, app, ios))
        for name, text, label in [
            ("a path as the tail of a longer folder name passes", "Fixtures live in zq-%s." % spec, None),
            ("a path as the tail of a longer path passes", "Built from web%ssystem." % app, None),
            ("a path as the tail of a word passes", "Run the scenar%s suite." % ios, None),
            ("a path in backticks fails", "Fixtures live in `%s`." % spec, spec),
            ("a path after a space fails", "See %sx.md." % spec, spec),
            ("a path in brackets fails", "Fixtures live here (%sx.md)." % spec, spec),
        ]:
            repo.write("AGENTS.md", short)
            repo.write("framework/process.md", FRAMEWORK_DOC + "\n" + text + "\n")
            out = repo.commit()
            expect(name, out, fail=label is not None, needle=repr(label) if label else None)
            if out.returncode == 0:
                repo.run("git", "reset", "-q", "--hard", "HEAD~1", check=True)
            repo.discard()

        repo.write("framework/conventions/ios.md", "# iOS\n\nzebraphone\n")
        repo.run("git", "add", "-A", check=True)
        out = repo.run("git", "commit", "-q", "--no-verify", "-m", "plant\n\nHook-bypassed: test fixture")
        report("bypass with --no-verify lands", out.returncode == 0, out.stderr)
        repo.write("framework/process.md", FRAMEWORK_DOC + "\nA harmless edit.\n")
        expect("whole framework/ tree is searched, not only changed files", repo.commit(), fail=True, needle="conventions/ios.md:3")
        repo.discard()
        repo.run("git", "reset", "-q", "--hard", "HEAD~1", check=True)

        repo.write("AGENTS.md", AGENTS + "- **Boundary terms:** Zebraphone, zebra call, role\n")
        expect("staging AGENTS.md triggers the search", repo.commit(), fail=True, needle="'role'")
        repo.discard()

        repo.write("AGENTS.md", AGENTS_NO_TERMS)
        repo.write("framework/process.md", FRAMEWORK_DOC + "\nA harmless edit.\n")
        expect("missing Boundary terms line fails when framework/ is staged", repo.commit(), fail=True, needle="Boundary terms")
        repo.discard()

        repo.write("zq-notes/brief.md", "# Brief\n\nZebraphone is a phone app.\n")
        expect("product terms outside framework/ pass", repo.commit(), fail=False)

        # --- an unfilled template: placeholder cells aren't paths ----------
        with open(os.path.join(os.path.dirname(HOOKS_DIR), "agents-template.md"), encoding="utf-8") as f:
            template = f.read()
        filled = re.sub(r"^(- \*\*Boundary terms:\*\*) <.*>$", r"\1 Zebraphone, zebra call", template, flags=re.M)
        fresh = Repo(os.path.join(base, "unfilled-template"))
        fresh.install()
        fresh.write("framework/agents-template.md", template)
        fresh.write("AGENTS.md", filled)
        expect("unfilled template with Boundary terms passes", fresh.commit("first"), fail=False)
        fresh.write("AGENTS.md", filled.replace("| Product brief | <", "| Product brief | `AGENTS.md`, not <"))
        expect("a bare filename isn't searched", fresh.commit(), fail=False)
        fresh.write("AGENTS.md", filled.replace("| Product brief | <", "| Product brief | `zq-notes/brief.md`, not <"))
        fresh.write("framework/notes.md", "See zq-notes/brief.md.\n")
        expect("a filled cell is still searched", fresh.commit(), fail=True, needle="'zq-notes/brief.md'")
        fresh.discard()

        # --- range mode: the same checks on a finished change --------------
        hook = os.path.join(repo.hooks, "pre-commit")
        start = repo.run("git", "rev-parse", "HEAD", check=True).stdout.strip()
        expect("range: a clean change passes", repo.run(hook, "--range", "HEAD~3"), fail=False)

        repo.write("framework/conventions/ios.md", "# iOS\n\nzebraphone\n")
        repo.run("git", "add", "-A", check=True)
        repo.run("git", "commit", "-q", "--no-verify", "-m", "plant\n\nHook-bypassed: test fixture", check=True)
        repo.write("zq-notes/brief.md", "# Brief\n\nTrailing space here. \n")
        repo.run("git", "add", "-A", check=True)
        repo.run("git", "commit", "-q", "--no-verify", "-m", "space\n\nHook-bypassed: test fixture", check=True)
        expect("range: a bypassed product term fails", repo.run(hook, "--range", start), fail=True, needle="conventions/ios.md:3")
        expect("range: bypassed whitespace fails", repo.run(hook, "--range", start), fail=True, needle="whitespace")
        expect("range: names the range", repo.run(hook, "--range", start), fail=True, needle="...HEAD")
        repo.run("git", "reset", "-q", "--hard", start, check=True)

        repo.write("schema-zq/calling.md", FEATURE.replace("## Non-goals\n\n- Video\n\n", ""))
        repo.run("git", "add", "-A", check=True)
        first = repo.run("git", "rev-list", "--max-parents=0", "HEAD", check=True).stdout.strip()
        expect("range: reads HEAD, not the index", repo.run(hook, "--range", first), fail=False)
        repo.discard()

        expect("range: a base that isn't a commit fails", repo.run(hook, "--range", "no-such-ref"), fail=True, needle="isn't a commit")

        # --- the framework's own repository: no AGENTS.md ------------------
        fw = Repo(os.path.join(base, "framework-repo"), framework_prefix="")
        expect("install in the framework repository", fw.install(), fail=False, needle="hooks active")
        fw.write("process.md", FRAMEWORK_DOC + "\nZebraphone would be a leak in a consumer, but nothing names terms here.\n")
        expect("no AGENTS.md: only whitespace runs", fw.commit("first"), fail=False)
        fw.write("process.md", FRAMEWORK_DOC + "\ttab then space \n")
        expect("no AGENTS.md: whitespace still fails", fw.commit(), fail=True, needle="whitespace")
    finally:
        shutil.rmtree(base, ignore_errors=True)

    passed = sum(1 for r in results if r)
    print("\n%d of %d cases passed" % (passed, len(results)))
    return 0 if passed == len(results) else 1


if __name__ == "__main__":
    sys.exit(main())
