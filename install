#!/usr/bin/python3
"""First install: wire the framework into a project with one command.

Run it from a clone of the framework's repository, pointed at the project:

    ./install <project path> [--boundary-terms "<terms>"] [--release v<version>] [--adapter claude-code|pi]

It checks every refusal before its first change, and changes nothing if one
applies. Then, in a worktree beside the project on a new branch,
`install-framework-v<version>`, never on `main`, it:

1. adds the release as a git subtree in `framework/`, from this clone's
   `origin` URL as it is (`git subtree add --squash`);
2. runs `framework/hooks/install`, which turns on the framework's hooks;
3. makes one wiring commit, which the hooks check: a new `AGENTS.md` from the
   release's `agents-template.md`, and with `--adapter`, the adapter's
   settings merged into its harness's project settings: for `claude-code`,
   `.claude/settings.json`, with `@AGENTS.md` added to an existing
   `CLAUDE.md`; for `pi`, `.pi/settings.json`.

Everything it copies or merges is read from the release it installs, not
from this clone. It never commits to `main`, pushes or opens a change
request, and never overwrites a project's own files. If a step fails, it
removes what it made. It ends by printing what's left for people and agents
to do (`framework-changes.md`, First install).

`--release` defaults to the newest `v*` tag on `origin`. `--boundary-terms`
is required when the project has no `AGENTS.md`.

Exit 0: installed. Exit 1: refused, or a step failed and was rolled back.

Once installed, any checkout of the project, a ticket worktree included:

    ./install --check <checkout> [--adapter claude-code|pi]
    ./install --wire <checkout> [--adapter claude-code|pi]

`--check` changes nothing and reports each piece of wiring the release in the
checkout's `framework/` expects, as ok, missing or different. The release's
own files at HEAD are the description of its wiring, never this clone's.
`--wire` makes the changes `--check` marks as its, in the working tree, on a
branch other than `main`, and commits nothing (`framework-changes.md`,
Checking the wiring). Exit 0: nothing left to fix. Exit 1: something is left,
or it refused.
"""

import argparse
import copy
import json
import os
import re
import shutil
import subprocess
import sys

MIN_RELEASE = (6, 1, 0)  # the first release that ships this command
# Each adapter, and the project settings file its harness reads, which the
# adapter's settings.json is merged into.
ADAPTER_SETTINGS = {"claude-code": ".claude/settings.json", "pi": ".pi/settings.json"}
ADAPTERS = tuple(ADAPTER_SETTINGS)
VERSION = re.compile(r"^v(\d+)\.(\d+)\.(\d+)$")
PLACEHOLDER = re.compile(r"<[^<>\n]+>")
BACKTICKED = re.compile(r"`[^`\n]*`")
BOLD_LABEL = re.compile(r"^- \*\*([^*:]+)")

# Test only: `test` sets this to a step's name to fail just after that step.
FAIL_AFTER = os.environ.get("DUAL_NATIVE_INSTALL_FAIL_AFTER")


class Failure(Exception):
    pass


def git(*args, cwd, check=False):
    # No optional locks: a refusal must leave the project byte for byte as it was.
    env = dict(os.environ, GIT_OPTIONAL_LOCKS="0")
    out = subprocess.run(["git", *args], cwd=cwd, env=env, capture_output=True, text=True)
    if check and out.returncode != 0:
        raise Failure("git %s failed:\n%s%s" % (" ".join(args), out.stdout, out.stderr))
    return out


def version_text(v):
    return "%d.%d.%d" % v


# --- the framework clone and the release ----------------------------------------


class Release:
    pass


def read_release(here, requested, refusals):
    """The release to install, read from this clone's origin, or None."""
    top = git("rev-parse", "--show-toplevel", cwd=here)
    if top.returncode != 0 or os.path.realpath(top.stdout.strip()) != here:
        refusals.append(
            "%s isn't the root of a clone of the framework's repository. Run install from a clone: "
            "git clone <framework repository URL>, then <clone>/install <project path>." % here
        )
        return None
    url = git("remote", "get-url", "origin", cwd=here)
    if url.returncode != 0:
        refusals.append("this framework clone has no origin remote, so there's no URL to install from. "
                        "Clone the framework's repository again, or: git -C %s remote add origin <URL>." % here)
        return None
    url = url.stdout.strip()

    listing = git("ls-remote", "--tags", "origin", "v*", cwd=here)
    if listing.returncode != 0:
        refusals.append("can't read the release tags from origin, %s:\n%s" % (url, listing.stderr.strip()))
        return None
    tags = {}
    for line in listing.stdout.splitlines():
        sha, ref = line.split("\t")
        name = ref[len("refs/tags/"):]
        peeled = name.endswith("^{}")
        name = name[:-3] if peeled else name
        if VERSION.match(name) and (peeled or name not in tags):
            tags[name] = sha
    if requested is None:
        if not tags:
            refusals.append("origin, %s, has no v<version> release tags." % url)
            return None
        tag = max(tags, key=lambda t: tuple(int(n) for n in VERSION.match(t).groups()))
    else:
        tag = requested if requested.startswith("v") else "v" + requested
        if not VERSION.match(tag):
            refusals.append("--release %s isn't a release; give one as v<major>.<minor>.<patch>, such as v%s."
                            % (requested, version_text(MIN_RELEASE)))
            return None
        if tag not in tags:
            refusals.append("origin, %s, has no release tag %s. Its releases: %s." % (url, tag, ", ".join(sorted(tags)) or "none"))
            return None
    version = tuple(int(n) for n in VERSION.match(tag).groups())
    if version < MIN_RELEASE:
        refusals.append(
            "release %s is older than %s, the first release install can install%s. Install %s or later, "
            "or take an earlier release by hand." % (
                tag, version_text(MIN_RELEASE),
                "" if requested else " (it's the newest tag on origin)", "v" + version_text(MIN_RELEASE))
        )
        return None

    commit = tags[tag]
    if git("cat-file", "-e", commit + "^{commit}", cwd=here).returncode != 0:
        fetched = git("fetch", "-q", "--no-tags", "origin", "refs/tags/" + tag, cwd=here)
        if fetched.returncode != 0 or git("cat-file", "-e", commit + "^{commit}", cwd=here).returncode != 0:
            refusals.append("can't fetch %s from origin, %s:\n%s" % (tag, url, fetched.stderr.strip()))
            return None

    release = Release()
    release.here, release.url, release.tag, release.commit = here, url, tag, commit
    release.version = version_text(version)
    release.tree = git("rev-parse", commit + "^{tree}", cwd=here, check=True).stdout.strip()
    return release


def release_file(release, path):
    out = git("show", "%s:%s" % (release.commit, path), cwd=release.here)
    return out.stdout if out.returncode == 0 else None


def term_in_release(release, term):
    """Where `term` appears in the release, as the hook's boundary search would find it, or None:
    ignoring case, and never inside another word (hooks/pre-commit, check_boundary)."""
    out = git("grep", "-I", "-i", "-n", "-F", "-e", term, release.commit, "--", cwd=release.here)
    if out.returncode != 0 or not out.stdout:
        return None
    pattern = re.compile(r"(?<![A-Za-z])" + re.escape(term), re.IGNORECASE)
    for line in out.stdout.splitlines():
        where = line[len(release.commit) + 1:]
        path, _, rest = where.partition(":")
        _, _, text = rest.partition(":")
        if pattern.search(text):
            return where
    return None


# --- what install writes ----------------------------------------------------------


def fill_template(template, release, terms, adapter):
    """The release's agents-template.md with only the four things install knows
    filled in, or a reason it can't be."""
    swaps = [
        ("the framework's repository", re.compile(r"<the framework's repository>"), "`%s`" % release.url),
        ("the release", re.compile(r"(framework release )<version>"), r"\g<1>" + release.version),
        ("the Harness adapter row", re.compile(r"^(\| Harness adapter \| )<.*>( \|)$", re.M),
         r"\g<1>%s\g<2>" % ("`framework/adapters/%s`" % adapter if adapter else "None")),
        ("the Boundary terms line", re.compile(r"^(- \*\*Boundary terms:\*\* )<.*>$", re.M),
         r"\g<1>" + ", ".join(terms).replace("\\", r"\\")),
    ]
    for what, pattern, replacement in swaps:
        template, count = pattern.subn(replacement, template)
        if count != 1:
            return None, "the release's agents-template.md has no placeholder for %s where install expects one" % what
    return template, None


def with_agents_import(claude_md):
    """CLAUDE.md's text with the line @AGENTS.md added at its end, in its own line endings."""
    eol = "\r\n" if "\r\n" in claude_md else "\n"
    if claude_md and not claude_md.endswith("\n"):
        claude_md += eol
    return claude_md + (eol if claude_md.strip() else "") + "@AGENTS.md" + eol


def package_name(entry):
    """A pi package entry's source without its ref, such as `git:github.com/owner/repo`; None for anything else."""
    source = entry.get("source") if isinstance(entry, dict) else entry
    if not isinstance(source, str):
        return None
    match = re.match(r"^((?:git|npm):.+?)(?:@[^@/]+)?$", source)
    return match.group(1) if match else None


def list_additions(existing, adding, here):
    """The entries of `adding` that `existing` lacks, and the clashes: in a
    top-level `packages` list, an entry naming a package the project already
    lists at another ref clashes rather than adds a second copy."""
    added, clashes = [], []
    for value in adding:
        if value in existing:
            continue
        name = package_name(value) if here == ("packages",) else None
        theirs = [e for e in existing if name and package_name(e) == name]
        if theirs:
            clashes.append((".".join(here), theirs[0], value))
        else:
            added.append(value)
    return added, clashes


def merge_settings(existing, adding, path=()):
    """`adding` merged into `existing`: missing keys added, list entries not
    already there appended, every existing key kept. Returns the result and
    the keys where `adding` sets a different single value, or a package at
    another ref."""
    merged = dict(existing)
    clashes = []
    for key, value in adding.items():
        here = path + (key,)
        if key not in existing:
            merged[key] = copy.deepcopy(value)
        elif isinstance(value, dict) and isinstance(existing[key], dict):
            merged[key], more = merge_settings(existing[key], value, here)
            clashes += more
        elif isinstance(value, list) and isinstance(existing[key], list):
            added, more = list_additions(existing[key], value, here)
            merged[key] = list(existing[key]) + [copy.deepcopy(v) for v in added]
            clashes += more
        elif existing[key] != value:
            clashes.append((".".join(here), existing[key], value))
    return merged, clashes


# --- pre-flight -------------------------------------------------------------------


class Plan:
    pass


def preflight(args, here):
    """Every refusal, before any change. Returns (plan, refusals)."""
    refusals = []
    plan = Plan()
    plan.adapter = args.adapter
    plan.terms = None
    if args.boundary_terms is not None:
        plan.terms = [t.strip() for t in args.boundary_terms.split(",") if t.strip()]
        if not plan.terms or "\n" in args.boundary_terms:
            refusals.append('--boundary-terms needs one or more comma-separated terms on one line, '
                            'such as --boundary-terms "Zebraphone, zebra call".')
            plan.terms = None

    release = read_release(here, args.release, refusals)
    plan.release = release

    target = os.path.abspath(args.project)
    plan.target = target
    if not os.path.isdir(target):
        refusals.append("there's no folder at %s." % target)
        return plan, refusals
    top = git("rev-parse", "--show-toplevel", cwd=target)
    if top.returncode != 0:
        refusals.append("%s isn't a git repository. Make it one with a first commit and an origin: "
                        "git init -b main, git commit --allow-empty -m \"First commit\", "
                        "git remote add origin <URL>." % target)
        return plan, refusals
    top = os.path.realpath(top.stdout.strip())
    if top != os.path.realpath(target):
        refusals.append("%s is inside the repository at %s. Pass the repository's folder: ./install %s" % (target, top, top))
        return plan, refusals
    target = plan.target = top
    git_dir = git("rev-parse", "--path-format=absolute", "--git-dir", cwd=target).stdout.strip()
    common = git("rev-parse", "--path-format=absolute", "--git-common-dir", cwd=target).stdout.strip()
    if os.path.realpath(git_dir) != os.path.realpath(common):
        main_checkout = os.path.dirname(os.path.realpath(common))
        refusals.append("%s is a linked worktree. Pass the project's main checkout: ./install %s" % (target, main_checkout))
        return plan, refusals
    if target == here:
        refusals.append("%s is the framework's own repository; point install at a project." % target)
        return plan, refusals

    if git("subtree", "-h", cwd=here).returncode not in (0, 129):
        refusals.append("this git has no subtree command (git subtree). Install a git that includes it, such as Homebrew's.")
    if git("var", "GIT_COMMITTER_IDENT", cwd=target).returncode != 0:
        refusals.append("git has no name and email to commit with in %s. Set them: "
                        "git config --global user.name \"<name>\", git config --global user.email <email>." % target)

    has_commits = bool(git("rev-list", "-n", "1", "--all", cwd=target).stdout.strip())
    has_main = git("rev-parse", "--verify", "-q", "refs/heads/main^{commit}", cwd=target).returncode == 0
    if not has_commits:
        refusals.append("%s has no commits. Make a first one on main: git commit --allow-empty -m \"First commit\"." % target)
    elif not has_main:
        current = git("symbolic-ref", "-q", "--short", "HEAD", cwd=target).stdout.strip()
        refusals.append(
            "%s has no main branch, which every framework branch starts from (framework/process.md, Branches). "
            "%s" % (target, "Rename yours: git branch -m %s main." % current if current else "Create one: git branch main <commit>.")
        )
    if git("remote", "get-url", "origin", cwd=target).returncode != 0:
        refusals.append("%s has no origin remote, where the install branch is pushed. Add one: git remote add origin <URL>." % target)
    dirty = git("status", "--porcelain", "--untracked-files=normal", cwd=target).stdout.splitlines()
    if dirty:
        refusals.append("%s has uncommitted changes or untracked files; commit, stash or remove them first:\n%s"
                        % (target, "\n".join("    " + line for line in dirty[:10]) + ("\n    …" if len(dirty) > 10 else "")))
    if os.path.lexists(os.path.join(target, "framework")) or (
            has_main and git("cat-file", "-e", "main:framework", cwd=target).returncode == 0):
        refusals.append(
            "%s already has a framework/ folder. install is for the first install only. To move to a newer release, "
            "take it in a take ticket (framework/framework-changes.md, Taking a release)." % target
        )

    hooks_path = git("config", "--get", "core.hooksPath", cwd=target)
    plan.hooks_path_was_set = hooks_path.returncode == 0
    value = hooks_path.stdout.strip()
    if hooks_path.returncode == 0 and os.path.normpath(value) != os.path.join("framework", "hooks"):
        scope = "locally" if git("config", "--local", "--get", "core.hooksPath", cwd=target).returncode == 0 else "globally or system-wide"
        resolved = os.path.realpath(os.path.join(target, os.path.expanduser(value)))
        if resolved == os.path.join(target, "framework", "hooks"):
            refusals.append(
                "core.hooksPath is set %s to %s, an absolute path to framework/hooks, so the install branch's worktree "
                "would run the main checkout's hooks. Make it relative, as framework/hooks/install sets it: "
                "git config %score.hooksPath framework/hooks."
                % (scope, value, "" if scope == "locally" else "--global ")
            )
        else:
            refusals.append(
                "core.hooksPath is set %s to %s, and the framework's hooks need it to be framework/hooks. Unset it "
                "(git config %s--unset core.hooksPath) and run install again; then call framework/hooks/pre-commit from "
                "your own pre-commit and pre-merge-commit (framework/hooks/README.md, Install)."
                % (scope, value, "" if scope == "locally" else "--global ")
            )

    if release is None:
        return plan, refusals

    plan.branch = "install-framework-" + release.tag
    plan.worktree = os.path.join(os.path.dirname(target), "%s-%s" % (os.path.basename(target), plan.branch))
    if os.path.lexists(plan.worktree):
        refusals.append("%s already exists, where install makes its worktree. Remove it, or land what's there." % plan.worktree)
    if git("rev-parse", "--verify", "-q", "refs/heads/" + plan.branch, cwd=target).returncode == 0:
        refusals.append("the branch %s already exists, from an earlier install. Delete it (git branch -D %s) or land it."
                        % (plan.branch, plan.branch))

    def on_main(path):
        if not has_main:
            return None
        out = git("show", "main:" + path, cwd=target)
        return out.stdout if out.returncode == 0 else None

    def ignored(path):
        return git("check-ignore", "-q", path, cwd=target).returncode == 0

    # AGENTS.md: a new one from the release's template, or the project's own, untouched.
    plan.writes = {}
    plan.agents_existed = on_main("AGENTS.md") is not None
    if not plan.agents_existed:
        if plan.terms is None and args.boundary_terms is None:
            refusals.append(
                "%s has no AGENTS.md, so install writes one, and its Boundary terms line needs the product's terms: "
                "add --boundary-terms \"<the app's name, and the product words a stranger would recognise it by>\"." % target
            )
        template = release_file(release, "agents-template.md")
        if template is None:
            refusals.append("release %s has no agents-template.md." % release.tag)
        elif plan.terms:
            filled, why = fill_template(template, release, plan.terms, plan.adapter)
            if why:
                refusals.append(why + ".")
            else:
                plan.writes["AGENTS.md"] = filled
        if ignored("AGENTS.md"):
            refusals.append("%s's .gitignore ignores AGENTS.md, which install commits. Stop ignoring it." % target)
    for term in plan.terms or []:
        where = term_in_release(release, term)
        if where:
            refusals.append(
                "the boundary term %r already appears in release %s, at %s, so every commit that touches framework/ "
                "would fail the boundary search. Use terms the framework doesn't use." % (term, release.tag, where)
            )

    if plan.adapter:
        adding_text = release_file(release, "adapters/%s/settings.json" % plan.adapter)
        try:
            adding = json.loads(adding_text) if adding_text is not None else None
        except ValueError:
            adding = None
        settings_path = ADAPTER_SETTINGS[plan.adapter]
        if not isinstance(adding, dict):
            refusals.append("release %s has no readable adapters/%s/settings.json." % (release.tag, plan.adapter))
        else:
            existing_text = on_main(settings_path)
            existing = {}
            if existing_text is not None:
                try:
                    existing = json.loads(existing_text)
                except ValueError as e:
                    existing = None
                    refusals.append("%s's %s on main isn't valid JSON (%s). Fix it first." % (target, settings_path, e))
                if existing is not None and not isinstance(existing, dict):
                    existing = None
                    refusals.append("%s's %s on main isn't a JSON object. Fix it first." % (target, settings_path))
            elif ignored(settings_path):
                refusals.append("%s's .gitignore ignores %s, which the adapter needs shared and committed. Stop "
                                "ignoring it, such as with a line !%s." % (target, settings_path, settings_path))
            if existing is not None:
                merged, clashes = merge_settings(existing, adding)
                for key, theirs, ours in clashes:
                    refusals.append(
                        "%s's %s sets %s to %s, and the adapter sets it to %s. Decide which to keep, "
                        "and change or remove yours on main (framework/adapters/%s/README.md, Wiring it in)."
                        % (target, settings_path, key, json.dumps(theirs), json.dumps(ours), plan.adapter)
                    )
                if merged != existing or existing_text is None:
                    plan.writes[settings_path] = json.dumps(merged, indent=2, ensure_ascii=False) + "\n"
    if plan.adapter == "claude-code":
        claude_md = on_main("CLAUDE.md")
        link = has_main and git("ls-tree", "main", "--", "CLAUDE.md", cwd=target).stdout.startswith("120000 ")
        if link:
            if os.path.normpath(claude_md.strip()) != "AGENTS.md":
                refusals.append("%s's CLAUDE.md is a symbolic link to %s, and install doesn't write through a link. "
                                "Add the line @AGENTS.md to its target, or link it to AGENTS.md, on main."
                                % (target, claude_md.strip()))
        elif claude_md is not None and "@AGENTS.md" not in [line.strip() for line in claude_md.splitlines()]:
            plan.writes["CLAUDE.md"] = with_agents_import(claude_md)

    return plan, refusals


# --- the changes, with rollback ---------------------------------------------------


def run_step(name, action):
    action()
    if FAIL_AFTER == name:
        raise Failure("failing after the %s step, as DUAL_NATIVE_INSTALL_FAIL_AFTER asks" % name)


def install(plan):
    release, target, wt = plan.release, plan.target, plan.worktree
    made = {"worktree": False, "hooks": False}

    def add_worktree():
        git("worktree", "add", "-q", "-b", plan.branch, wt, "main", cwd=target, check=True)
        made["worktree"] = True

    def add_subtree():
        git("subtree", "add", "--prefix=framework", release.url, release.tag, "--squash", cwd=wt, check=True)
        tree = git("rev-parse", "HEAD:framework", cwd=wt, check=True).stdout.strip()
        if tree != release.tree:
            raise Failure("framework/ after the subtree add is tree %s, not release %s's tree %s" % (tree, release.tag, release.tree))

    def install_hooks():
        out = subprocess.run([os.path.join(wt, "framework", "hooks", "install")], cwd=wt, capture_output=True, text=True)
        if out.returncode != 0:
            raise Failure("framework/hooks/install failed:\n%s%s" % (out.stdout, out.stderr))
        made["hooks"] = not plan.hooks_path_was_set

    def wire():
        if not plan.writes:
            return
        for path, text in plan.writes.items():
            full = os.path.join(wt, path)
            os.makedirs(os.path.dirname(full), exist_ok=True)
            with open(full, "w", encoding="utf-8") as f:
                f.write(text)
        git("add", "--", *plan.writes, cwd=wt, check=True)
        lines = []
        if "AGENTS.md" in plan.writes:
            lines.append("- AGENTS.md, from framework/agents-template.md, with the framework's URL and release, "
                         "the Harness adapter row and the Boundary terms line filled in.")
        settings_path = ADAPTER_SETTINGS.get(plan.adapter)
        if settings_path in plan.writes:
            lines.append("- %s, with framework/adapters/%s/settings.json merged in." % (settings_path, plan.adapter))
        if "CLAUDE.md" in plan.writes:
            lines.append("- CLAUDE.md: @AGENTS.md, so that Claude Code reads AGENTS.md.")
        message = "Wire in framework release %s\n\nFirst install (framework/framework-changes.md):\n\n%s\n" % (
            release.version, "\n".join(lines))
        out = git("commit", "-q", "-m", message, cwd=wt)
        if out.returncode != 0:
            raise Failure("the wiring commit failed, and the framework's hooks ran on it:\n%s%s" % (out.stdout, out.stderr))

    try:
        run_step("worktree", add_worktree)
        run_step("subtree", add_subtree)
        run_step("hooks", install_hooks)
        run_step("wiring", wire)
    except (Failure, KeyboardInterrupt) as e:
        sys.stderr.write("install: %s\n" % (e if isinstance(e, Failure) else "interrupted"))
        rollback(plan, made)
        return False
    return True


def rollback(plan, made):
    target = plan.target
    undone = []
    if made["worktree"]:
        if git("worktree", "remove", "--force", plan.worktree, cwd=target).returncode != 0:
            shutil.rmtree(plan.worktree, ignore_errors=True)
            git("worktree", "prune", cwd=target)
        git("branch", "-q", "-D", plan.branch, cwd=target)
        undone.append("removed the worktree %s and the branch %s" % (plan.worktree, plan.branch))
    if made["hooks"]:
        git("config", "--local", "--unset", "core.hooksPath", cwd=target)
        undone.append("unset core.hooksPath")
    sys.stderr.write("install: rolled back: %s. Nothing else was changed.\n" % ("; ".join(undone) or "nothing to undo"))


# --- what's left -------------------------------------------------------------------

WHO = [
    ("You, the product owner and framework steward, before landing",
     {"app name", "section:", "section:skills and roles", "product owner", "framework steward",
      "section:human roles", "tracker", "tracker binding"}),
    ("The product role, in the first ticket (or the adoption ticket)",
     {"app schema", "product brief", "decision records", "glossary", "design source", "testing reference"}),
    ("The ticket that sets up the app",
     {"ios app", "android app", "app identifier", "ios", "android", "android jdk", "android colour", "spoken screen-reader output", "section:app settings"}),
    ("setup-matt-pocock-skills, once the tracker is chosen", {"section:agent skills"}),
    ("Whoever records a deviation, when one arises", {"section:deviations"}),
]


def placeholders(text):
    """(line number, key, label) for each line of AGENTS.md still holding a `<…>` placeholder."""
    found = []
    section = ""
    for n, line in enumerate(text.splitlines(), 1):
        if line.startswith("## "):
            section = line[3:].strip().lower()
            continue
        bare = BACKTICKED.sub("", line)
        holes = PLACEHOLDER.findall(bare)
        if not holes:
            continue
        if line.startswith("# "):
            key, label = "app name", "App name"
        elif line.startswith("|"):
            label = line.strip("|").split("|")[0].strip()
            key = label.lower()
        elif BOLD_LABEL.match(line):
            label = BOLD_LABEL.match(line).group(1).strip()
            key = label.lower()
        else:
            key = "section:" + section
            words = line.strip().lstrip("- ")
            label = (words[:64] + "…") if len(words) > 64 else words
        found.append((n, key, label))
    return found


def tracker_setup(release):
    """Each tracker binding in the release, with its one-time setup section."""
    bindings = []
    listing = git("ls-tree", "--name-only", release.commit, "trackers/", cwd=release.here).stdout.split()
    for path in listing:
        text = release_file(release, path) or ""
        match = re.search(r"^## Before you start\n(.*?)(?=^## |\Z)", text, re.M | re.S)
        bindings.append(("framework/" + path, match.group(1).strip() if match else None))
    return bindings


def indent(text, by):
    return "\n".join((by + line) if line.strip() else "" for line in text.splitlines())


def whats_left(plan):
    release, wt = plan.release, plan.worktree
    out = []
    log = git("log", "--format=%h %s", "main..HEAD", "--first-parent", cwd=wt).stdout.strip()
    out.append("install: installed framework release %s in %s, on the branch %s, in %s."
               % (release.version, plan.target, plan.branch, wt))
    out.append("main is unchanged and nothing is pushed. The branch's commits:\n" + indent(log, "  "))
    out.append("\nWhat's left, in order:\n")
    steps = []

    if plan.agents_existed:
        terms = ", ".join(plan.terms) if plan.terms else "<the app's name and product words>"
        steps.append(
            "Merge framework/agents-template.md into your own AGENTS.md, on the install branch, before landing: "
            "add each heading and row it lacks, keeping your content, including the Boundary terms line under "
            "App settings:\n\n    - **Boundary terms:** %s\n\n"
            "install never edits an existing AGENTS.md. The hook's boundary search needs that line once framework/ "
            "is in." % terms
        )
    else:
        with open(os.path.join(wt, "AGENTS.md"), encoding="utf-8") as f:
            found = placeholders(f.read())
        groups = []
        for who, keys in WHO:
            rows = [(n, label) for n, key, label in found if key in keys]
            if rows:
                groups.append((who, rows))
        rest = [(n, label) for n, key, label in found if not any(key in keys for _, keys in WHO)]
        if rest:
            groups.append(("Anyone", rest))
        text = ("Fill in AGENTS.md's placeholders, the `<…>` text, by line in %s. Fill yours on the install "
                "branch; tickets fill the rest. Until then, the hooks skip a placeholder.\n" % os.path.join(wt, "AGENTS.md"))
        for who, rows in groups:
            text += "\n%s:\n" % who
            text += "\n".join("    line %-4d %s" % (n, label) for n, label in rows) + "\n"
        steps.append(text.rstrip())

    bindings = tracker_setup(release)
    text = ("Choose a tracker and its binding, and name both in AGENTS.md's Tracker and Tracker binding rows. "
            "This release has: %s. For another tracker, write the project's own binding (framework/tracker.md). "
            "Each binding's one-time setup, which install doesn't run:"
            % (", ".join(path for path, _ in bindings) or "none"))
    for path, setup in bindings:
        text += "\n\n  %s, Before you start:\n\n%s" % (path, indent(setup or "(none)", "    "))
    steps.append(text)

    if plan.adapter == "claude-code":
        steps.append("Each person, once per clone: open the project in Claude Code, accept the workspace trust dialog, then run\n\n"
                     "    claude plugin install mattpocock-skills@dual-native --scope project\n\n"
                     "(framework/adapters/claude-code/README.md, Wiring it in, steps 4 to 6).")
    elif plan.adapter == "pi":
        steps.append("Each person, once per machine: move any personal copy of Matt Pocock's skills out of the "
                     "places pi reads personal skills from, which it loads before the project's pinned copy: "
                     "<agent directory>/skills, any \"skills\" paths in <agent directory>/settings.json, and "
                     "~/.agents/skills. The agent directory is $PI_CODING_AGENT_DIR when that's set, and ~/.pi/agent "
                     "only when it isn't. Then, once per clone, open the project in pi and trust it: pi clones the "
                     "pinned skills itself (framework/adapters/pi/README.md, Wiring it in, steps 4 and 5).")
    else:
        steps.append("Each person: install the skills, Matt Pocock's skills as the plugin mattpocock-skills, at the commit "
                     "framework/adapters/claude-code/.claude-plugin/marketplace.json names (AGENTS.md, Skills and roles). "
                     "With Claude Code or pi, an adapter does this: add it later with a take ticket.")

    steps.append("If the app already ships, its first ticket is the adoption ticket (framework/adoption.md). "
                 "Otherwise, the first ticket starts the app schema (framework/schema-template.md).")
    steps.append("If the iOS and Android apps live in repositories of their own, see framework/separate-repositories.md.")

    pushed_main = git("rev-parse", "--verify", "-q", "refs/remotes/origin/main", cwd=plan.target).returncode == 0
    push = "" if pushed_main else "    git -C %s push -u origin main\n" % plan.target
    steps.append("Push the branch and open a change request into main:\n\n%s    git -C %s push -u origin %s"
                 % (push, wt, plan.branch))
    steps.append("Before landing, on the install branch, this must pass:\n\n"
                 "    cd %s && git fetch origin && framework/hooks/pre-commit --range origin/main\n\n"
                 "Then land it with a merge commit, never a squash: a squash drops the subtree's history, and every later "
                 "git subtree pull then fails (framework/framework-changes.md, First install)." % wt)

    for i, step in enumerate(steps, 1):
        lines = step.split("\n")
        out.append("%d. %s" % (i, lines[0]))
        out.extend(("   " + line) if line else "" for line in lines[1:])
        out.append("")
    return "\n".join(out).rstrip() + "\n"


# --- an installed project's wiring: --check and --wire -------------------------------

RELEASE_LINE = re.compile(r"framework release (v?)(\d+\.\d+\.\d+)")
ADAPTER_ROW = re.compile(r"^(\|[ \t]*Harness adapter[ \t]*\|)([^|\n]*)(\|)", re.M)
# As hooks/pre-commit reads it, one line at a time.
BOUNDARY_LINE = re.compile(r"^\s*(?:[-*]\s*)?\*\*Boundary terms:?\*\*:?\s*(.*)$")
TEMPLATE_RELEASE_LINE = ("`framework/` is a git subtree of <the framework's repository>, taken at framework release %s. "
                         "Only a take ticket edits it (`framework/framework-changes.md`).")


def parse_version(tag):
    return tuple(int(n) for n in VERSION.match(tag).groups())


def release_trees(here):
    """{tree: tag} for every v<version> tag in this clone."""
    names = [n for n in git("for-each-ref", "--format=%(refname:strip=2)", "refs/tags/", cwd=here).stdout.split()
             if VERSION.match(n)]
    trees = {}
    for name in names:
        out = git("rev-parse", "-q", "--verify", name + "^{tree}", cwd=here)
        if out.returncode == 0:
            trees[out.stdout.strip()] = name
    return trees


class Checkout:
    pass


def read_checkout(here, path, refusals):
    """The checkout --check or --wire looks at, and the release its framework/ holds at HEAD, or None."""
    top = git("rev-parse", "--show-toplevel", cwd=here)
    if top.returncode != 0 or os.path.realpath(top.stdout.strip()) != here:
        refusals.append("%s isn't the root of a clone of the framework's repository. Run install from a clone: "
                        "git clone <framework repository URL>, then <clone>/install --check <project path>." % here)
        return None
    target = os.path.abspath(path)
    if not os.path.isdir(target):
        refusals.append("there's no folder at %s." % target)
        return None
    top = git("rev-parse", "--show-toplevel", cwd=target)
    if top.returncode != 0:
        refusals.append("%s isn't a git repository." % target)
        return None
    top = os.path.realpath(top.stdout.strip())
    if top != os.path.realpath(target):
        refusals.append("%s is inside the repository at %s. Pass the checkout's folder: %s" % (target, top, top))
        return None
    if top == here:
        refusals.append("%s is the framework's own repository; point install at a project." % top)
        return None

    co = Checkout()
    co.top = top
    branch = git("symbolic-ref", "-q", "--short", "HEAD", cwd=top)
    co.branch = branch.stdout.strip() if branch.returncode == 0 else None
    tree = git("rev-parse", "-q", "--verify", "HEAD:framework", cwd=top)
    if tree.returncode != 0:
        refusals.append("%s has no framework/ at HEAD, so there's no release to check against. For the first "
                        "install, run: ./install %s" % (top, top))
        return None
    co.tree = tree.stdout.strip()

    trees = release_trees(here)
    if co.tree not in trees and git("remote", "get-url", "origin", cwd=here).returncode == 0:
        git("fetch", "-q", "--tags", "origin", cwd=here)
        trees = release_trees(here)
    co.tag = trees.get(co.tree)
    co.version = version_text(parse_version(co.tag)) if co.tag else None
    if co.tag and parse_version(co.tag) < MIN_RELEASE:
        refusals.append(
            "framework/ in %s is release %s, older than %s, the first release whose wiring install knows. Take %s "
            "or later in a take ticket (framework/framework-changes.md, Taking a release), then check the take "
            "ticket's worktree." % (top, co.version, version_text(MIN_RELEASE), version_text(MIN_RELEASE)))
        return None
    ours = git("describe", "--tags", "--abbrev=0", "--match", "v*", "HEAD", cwd=here).stdout.strip()
    if co.tag and VERSION.match(ours) and parse_version(co.tag) > parse_version(ours):
        refusals.append("framework/ in %s is release %s, newer than this clone of the framework, at %s, so this "
                        "install may not know its wiring. Update the clone: git -C %s pull" % (top, co.version, ours, here))
        return None
    return co


class Wiring:
    """What --check finds, one line per piece of wiring, and what --wire would change."""

    def __init__(self):
        self.lines = []  # (state, what, how, wires): state is ok, missing or different
        self.writes = {}  # path: new text
        self.hooks_install = False

    def ok(self, what):
        self.lines.append(("ok", what, None, False))

    def gap(self, state, what, how, wires=False):
        self.lines.append((state, what, how, wires))

    def gaps(self):
        return [line for line in self.lines if line[0] != "ok"]


def settings_missing(existing, adding, path=()):
    """What `existing` lacks of `adding`, as merge_settings would add it: (key path, value, is a list entry)."""
    missing = []
    for key, value in adding.items():
        here = path + (key,)
        if key not in existing:
            missing.append((".".join(here), value, False))
        elif isinstance(value, dict) and isinstance(existing[key], dict):
            missing += settings_missing(existing[key], value, here)
        elif isinstance(value, list) and isinstance(existing[key], list):
            missing += [(".".join(here), v, True) for v in list_additions(existing[key], value, here)[0]]
    return missing


def commands_in(value):
    if isinstance(value, dict):
        found = [value["command"]] if isinstance(value.get("command"), str) else []
        return found + [c for k, v in value.items() if k != "command" for c in commands_in(v)]
    if isinstance(value, list):
        return [c for v in value for c in commands_in(v)]
    return []


def describe_setting(key, value, entry):
    what = ("an entry in %s" if entry else "%s") % key
    commands = commands_in(value)
    if commands:
        return "%s, which runs %s" % (what, ", ".join(commands))
    if entry or not isinstance(value, (dict, list)):
        return "%s: %s" % (what, json.dumps(value))
    return what


def check_wiring(co, adapter):
    """The wiring framework/ at HEAD expects, against the checkout's working tree and its clone's hooks path."""
    w = Wiring()
    top = co.top

    def framework_file(path):
        out = git("show", "HEAD:framework/" + path, cwd=top)
        return out.stdout if out.returncode == 0 else None

    def work_file(path):
        try:
            with open(os.path.join(top, path), encoding="utf-8", newline="") as f:
                return f.read()
        except (FileNotFoundError, NotADirectoryError):
            return None

    # The hooks.
    hooks_path = git("config", "--get", "core.hooksPath", cwd=top)
    value = hooks_path.stdout.strip()
    framework_hooks = os.path.join("framework", "hooks")
    expanded = os.path.normpath(os.path.expanduser(value))
    if hooks_path.returncode != 0:
        w.gap("missing", "core.hooksPath isn't set, so git doesn't run the framework's hooks.",
              "runs framework/hooks/install, which sets it to framework/hooks.", wires=True)
        w.hooks_install = True
    elif os.path.normpath(value) == framework_hooks:
        w.ok("core.hooksPath is framework/hooks.")
    elif os.path.isabs(expanded) and expanded.endswith(os.sep + framework_hooks):
        w.gap("different", "core.hooksPath is %s, an absolute path, so every worktree runs that checkout's hooks "
              "rather than its own." % value, "Make it relative: git config core.hooksPath framework/hooks")
    else:
        own = os.path.join(top, expanded)
        calls = []
        for name in ("pre-commit", "pre-merge-commit"):
            try:
                with open(os.path.join(own, name), encoding="utf-8", errors="replace") as f:
                    text = f.read()
            except OSError:
                text = ""
            calls.append("framework/hooks/pre-commit" in text or (name == "pre-merge-commit" and "pre-commit" in text))
        if all(calls):
            w.ok("core.hooksPath is %s, whose pre-commit and pre-merge-commit call framework/hooks/pre-commit." % value)
        else:
            w.gap("different", "core.hooksPath is %s, whose pre-commit and pre-merge-commit don't both call "
                  "framework/hooks/pre-commit." % value,
                  "Call it from both, propagating failures (framework/hooks/README.md, Install).")

    # AGENTS.md: the lines install fills in.
    agents = work_file("AGENTS.md")
    named = None
    if agents is None:
        w.gap("missing", "AGENTS.md: there's none.",
              "Copy framework/agents-template.md to AGENTS.md and fill it in (framework/framework-changes.md, First install).")
    else:
        new_agents = agents
        line = RELEASE_LINE.search(agents)
        if not line:
            w.gap("missing", "AGENTS.md doesn't name the framework release.",
                  "Add the template's line, under Follow `framework/`: " + TEMPLATE_RELEASE_LINE % (co.version or "<version>"))
        elif co.version and line.group(2) != co.version:
            w.gap("different", "AGENTS.md names framework release %s, and framework/ is release %s."
                  % (line.group(2), co.version), "changes it to %s." % co.version, wires=True)
            new_agents = new_agents[:line.start(2)] + co.version + new_agents[line.end(2):]
        else:
            w.ok("AGENTS.md names framework release %s." % line.group(2))
        if "<the framework's repository>" in agents:
            w.gap("missing", "AGENTS.md doesn't name the framework's repository; it's still <the framework's repository>.",
                  "Put the repository's URL there, in backticks.")

        row = ADAPTER_ROW.search(new_agents)
        if not row:
            w.gap("missing", "AGENTS.md has no Harness adapter row in Where things live.",
                  "Add the template's row: | Harness adapter | `framework/adapters/<adapter>` |, or None in place of the path.")
        else:
            cell = row.group(2).strip()
            mentioned = re.search(r"framework/adapters/([A-Za-z0-9._-]+)", cell)
            placeholder = cell.startswith("<")
            if placeholder or cell.strip("`") == "None":
                if adapter:
                    w.gap("missing" if placeholder else "different",
                          "AGENTS.md's Harness adapter row is %s, not framework/adapters/%s."
                          % ("still its placeholder" if placeholder else "None", adapter),
                          "names `framework/adapters/%s` in it." % adapter, wires=True)
                    new_agents = new_agents[:row.start(2)] + " `framework/adapters/%s` " % adapter + new_agents[row.end(2):]
                elif placeholder:
                    w.gap("missing", "AGENTS.md's Harness adapter row is still its placeholder.",
                          "Name the adapter, such as `framework/adapters/claude-code`, or write None.")
                else:
                    w.ok("AGENTS.md's Harness adapter row is None.")
            elif not mentioned:
                w.gap("different", "AGENTS.md's Harness adapter row is %s, neither framework/adapters/<adapter> nor None." % cell,
                      "Name the adapter, such as `framework/adapters/claude-code`, or write None.")
            else:
                named = mentioned.group(1)
                if adapter and adapter != named:
                    w.gap("different", "AGENTS.md's Harness adapter row names framework/adapters/%s, not %s." % (named, adapter),
                          "Decide which adapter the project runs, and name it there.")
                elif framework_file("adapters/%s/README.md" % named) is None:
                    w.gap("different", "AGENTS.md's Harness adapter row names framework/adapters/%s, which framework/ "
                          "doesn't have." % named, "Name an adapter in framework/adapters/, or write None.")
                else:
                    w.ok("AGENTS.md's Harness adapter row names framework/adapters/%s." % named)

        terms = next(filter(None, (BOUNDARY_LINE.match(line) for line in agents.splitlines())), None)
        if not terms:
            w.gap("missing", "AGENTS.md has no Boundary terms line, so every commit that touches framework/ fails the hook.",
                  "Add it under App settings: - **Boundary terms:** <the app's name and product words>")
        elif not terms.group(1).strip() or terms.group(1).strip().startswith("<"):
            w.gap("missing", "AGENTS.md's Boundary terms line lists no terms.",
                  "List the app's name and the product words a stranger would recognise it by.")
        else:
            w.ok("AGENTS.md has a Boundary terms line.")
        if new_agents != agents:
            w.writes["AGENTS.md"] = new_agents

    # The adapter's own wiring.
    adapter = adapter or named
    if adapter in ADAPTERS:
        source = "framework/adapters/%s/settings.json" % adapter
        try:
            adding = json.loads(framework_file("adapters/%s/settings.json" % adapter) or "null")
        except ValueError:
            adding = None
        path = ADAPTER_SETTINGS[adapter]
        settings = work_file(path)
        if not isinstance(adding, dict):
            w.gap("different", "%s isn't there at HEAD, or isn't a JSON object, so the adapter's settings can't be "
                  "checked." % source, "Check framework/ is a release's tree (framework/framework-changes.md, Taking a release).")
        elif settings is None:
            if git("check-ignore", "-q", path, cwd=top).returncode == 0:
                w.gap("different", ".gitignore ignores %s, which the adapter needs shared and committed." % path,
                      "Stop ignoring it, such as with a line !%s." % path)
            else:
                w.gap("missing", "%s: there's none, and the adapter needs its settings there." % path,
                      "writes it from %s." % source, wires=True)
                w.writes[path] = json.dumps(adding, indent=2, ensure_ascii=False) + "\n"
        else:
            try:
                existing = json.loads(settings)
            except ValueError as e:
                existing = e
            if not isinstance(existing, dict):
                w.gap("different", "%s isn't a JSON object%s."
                      % (path, " (%s)" % existing if isinstance(existing, ValueError) else ""), "Fix it, then check again.")
            else:
                missing = settings_missing(existing, adding)
                merged, clashes = merge_settings(existing, adding)
                for key, value, entry in missing:
                    w.gap("missing", "%s lacks %s." % (path, describe_setting(key, value, entry)),
                          "adds it from %s." % source, wires=True)
                for key, theirs, ours in clashes:
                    w.gap("different", "%s sets %s to %s, and %s sets it to %s."
                          % (path, key, json.dumps(theirs), source, json.dumps(ours)),
                          "Decide which to keep (framework/adapters/%s/README.md, Wiring it in, step 2)." % adapter)
                if not missing and not clashes:
                    w.ok("%s has everything in %s." % (path, source))
                if missing:
                    w.writes[path] = json.dumps(merged, indent=2, ensure_ascii=False) + "\n"
        if adapter == "claude-code":
            claude_md = work_file("CLAUDE.md")
            linked = os.path.islink(os.path.join(top, "CLAUDE.md"))
            if linked and os.path.realpath(os.path.join(top, "CLAUDE.md")) == os.path.realpath(os.path.join(top, "AGENTS.md")):
                w.ok("CLAUDE.md is a link to AGENTS.md.")
            elif claude_md is None:
                w.ok("No CLAUDE.md, so Claude Code reads AGENTS.md itself.")
            elif "@AGENTS.md" in [line.strip() for line in claude_md.splitlines()]:
                w.ok("CLAUDE.md has @AGENTS.md.")
            elif linked:
                w.gap("missing", "CLAUDE.md, a link to %s, has no @AGENTS.md line, so Claude Code doesn't read AGENTS.md."
                      % os.readlink(os.path.join(top, "CLAUDE.md")), "Add the line @AGENTS.md to the link's target.")
            else:
                w.gap("missing", "CLAUDE.md has no @AGENTS.md line, so Claude Code doesn't read AGENTS.md.",
                      "adds the line @AGENTS.md at its end.", wires=True)
                w.writes["CLAUDE.md"] = with_agents_import(claude_md)
    return w


def wiring_report(co, w, verb):
    where = "on the branch %s" % co.branch if co.branch else "at a detached HEAD"
    out = ["install %s: %s, %s. framework/ at HEAD is %s.\n" % (
        verb, co.top, where, "release %s" % co.version if co.version else "no release's tree")]
    gaps = list(w.gaps())
    if not co.version:
        gaps.append(None)
        out.append("%-10s %s\n%-10s %s" % (
            "different", "framework/ matches no v<version> tag's tree, so its release isn't known or checked.", "",
            "A take ticket leaves it as the release's tree (framework/framework-changes.md, Taking a release)."))
    for state, what, how, wires in w.lines:
        out.append("%-10s %s" % (state, what))
        if state != "ok" and how:
            out.append("%-10s %s" % ("", ("--wire " + how) if wires else how))
    wirable = [g for g in w.gaps() if g[3]]
    if not gaps:
        out.append("\nWired as framework release %s expects." % co.version)
    elif verb == "--check" and wirable:
        files_only_off_main = co.branch in (None, "main") and w.writes
        out.append("\n%d to fix. %s./install --wire %s fixes %s, in the working tree%s%s." % (
            len(gaps), "On a branch other than main, " if files_only_off_main else "", co.top,
            "them all" if len(wirable) == len(gaps) else "%d of them" % len(wirable),
            "" if files_only_off_main else " on its branch",
            "" if len(wirable) == len(gaps) else "; the rest need a person, as above"))
    else:
        out.append("\n%d to fix, each by a person, as above." % len(gaps))
    return "\n".join(out) + "\n"


def wire_refusals(co, w):
    refusals = []
    if co.branch in (None, "main") and w.writes:
        refusals.append("%s is %s, and --wire changes files only on a branch other than main. Run it on the take "
                        "ticket's branch, or another branch from main." % (co.top, "on main" if co.branch else "at a detached HEAD"))
    links = [path for path in w.writes if os.path.islink(os.path.join(co.top, path))]
    if links:
        refusals.append("%s: %s %s a symbolic link, and --wire doesn't write through a link." % (
            co.top, ", ".join(links), "is" if len(links) == 1 else "are"))
    git_dir = git("rev-parse", "--path-format=absolute", "--git-dir", cwd=co.top).stdout.strip()
    if any(os.path.exists(os.path.join(git_dir, f)) for f in ("MERGE_HEAD", "CHERRY_PICK_HEAD", "REVERT_HEAD", "rebase-merge", "rebase-apply")):
        refusals.append("%s is partway through a merge, cherry-pick, revert or rebase. Finish it first." % co.top)
    if w.writes:
        dirty = git("status", "--porcelain", "--untracked-files=all", "--", *w.writes, cwd=co.top).stdout.splitlines()
        if dirty:
            refusals.append("%s has uncommitted changes in files --wire changes. Commit or stash them first, so that "
                            "its changes are the only ones there:\n%s" % (co.top, "\n".join("    " + line for line in dirty)))
    return refusals


def wire_in(co, w):
    """Makes the changes check_wiring marked as --wire's, in the working tree. Returns what it did."""
    done = []
    if w.hooks_install:
        out = subprocess.run([os.path.join(co.top, "framework", "hooks", "install")], cwd=co.top, capture_output=True, text=True)
        if out.returncode != 0:
            raise Failure("framework/hooks/install failed, and nothing was changed:\n%s%s" % (out.stdout, out.stderr))
        done.append("ran framework/hooks/install")
    for path, text in w.writes.items():
        full = os.path.join(co.top, path)
        os.makedirs(os.path.dirname(full), exist_ok=True)
        with open(full, "w", encoding="utf-8", newline="") as f:
            f.write(text)
        done.append("wrote %s" % path)
    return done


def check_or_wire(args, here):
    refusals = []
    co = read_checkout(here, args.project, refusals)
    w = check_wiring(co, args.adapter) if co else None
    if co and args.wire:
        refusals += wire_refusals(co, w)
    if refusals:
        sys.stderr.write("install: %s, and nothing was changed:\n" % ("refusing" if args.wire else "can't check"))
        for refusal in refusals:
            sys.stderr.write("- " + refusal + "\n")
        return 1
    if args.check:
        sys.stdout.write(wiring_report(co, w, "--check"))
        return 0 if not w.gaps() and co.version else 1

    try:
        done = wire_in(co, w)
    except Failure as e:
        sys.stderr.write("install: %s\n" % e)
        return 1
    after = check_wiring(co, args.adapter)
    sys.stdout.write("install --wire: %s.\n\n" % ("; ".join(done) if done else "nothing to wire"))
    sys.stdout.write(wiring_report(co, after, "--wire"))
    if w.writes:
        sys.stdout.write("\nNothing is committed. Check the changes (git -C %s diff) and commit them on %s; the hooks "
                         "check the commit.\n" % (co.top, co.branch))
    return 0 if not after.gaps() and co.version else 1


# --- main -------------------------------------------------------------------------


def main(argv):
    parser = argparse.ArgumentParser(
        prog="install",
        description="First install: wire the framework into a project (framework-changes.md, First install). "
                    "With --check or --wire, an installed project's wiring (framework-changes.md, Checking the wiring).",
    )
    parser.add_argument("project", help="the project's repository folder: its main checkout, or with --check or "
                                        "--wire, any checkout of it")
    parser.add_argument("--boundary-terms", help="comma-separated product terms for a new AGENTS.md's Boundary terms line")
    parser.add_argument("--release", help="the release to install, v<version>; defaults to the newest tag on origin")
    parser.add_argument("--adapter", choices=ADAPTERS, help="also wire in, or check, this harness adapter")
    mode = parser.add_mutually_exclusive_group()
    mode.add_argument("--check", action="store_true",
                      help="change nothing, and report each piece of wiring framework/'s release expects that is missing or different")
    mode.add_argument("--wire", action="store_true",
                      help="wire in what --check finds that a command can, in the working tree, on a branch other than main")
    args = parser.parse_args(argv)

    here = os.path.dirname(os.path.realpath(__file__))
    if args.check or args.wire:
        if args.boundary_terms is not None or args.release is not None:
            parser.error("--boundary-terms and --release are for the first install, not --check or --wire")
        return check_or_wire(args, here)
    plan, refusals = preflight(args, here)
    if refusals:
        sys.stderr.write("install: refusing, and nothing was changed:\n")
        for refusal in refusals:
            sys.stderr.write("- " + refusal + "\n")
        return 1
    if not install(plan):
        return 1
    sys.stdout.write(whats_left(plan))
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
