#!/bin/bash
# Put both apps, built from one branch, in front of the product owner.
#
#   scripts/run-both <branch>          build, install and open both apps
#   scripts/run-both --stop <branch>   remove what the first form made
#
# It works in its own worktree, simulator and emulator instance, as AGENTS.md
# (Working in parallel) says, and leaves the checkout it is run from alone.
set -euo pipefail

APP_ID=md.alasdair.cute
AVD=cute-api36
DEVICE_TYPE=com.apple.CoreSimulator.SimDeviceType.iPhone-18-Pro
SDK="${ANDROID_HOME:-$HOME/Library/Android/sdk}"
ADB="$SDK/platform-tools/adb"
export JAVA_HOME="/Applications/Android Studio.app/Contents/jbr/Contents/Home"

stop=false
if [ "${1:-}" = "--stop" ]; then stop=true; shift; fi
branch="${1:?usage: scripts/run-both [--stop] <branch>}"

repo="$(git rev-parse --show-toplevel)"
name="cute-$(echo "$branch" | tr '/' '-')-accept"
tree="$(dirname "$repo")/$name"
port_file="$tree/.build/emulator-port"

simulator() { xcrun simctl list devices -j | python3 -c '
import json, sys
for devices in json.load(sys.stdin)["devices"].values():
    for d in devices:
        if d["name"] == sys.argv[1]:
            print(d["udid"]); sys.exit()' "$name"; }

if $stop; then
    if [ -f "$port_file" ]; then
        "$ADB" -s "emulator-$(cat "$port_file")" emu kill >/dev/null 2>&1 || true
    fi
    udid="$(simulator)"
    if [ -n "$udid" ]; then
        xcrun simctl shutdown "$udid" >/dev/null 2>&1 || true
        xcrun simctl delete "$udid"
    fi
    if [ -d "$tree" ]; then git -C "$repo" worktree remove --force "$tree"; fi
    echo "Removed the worktree, simulator and emulator instance for $branch."
    exit 0
fi

"$SDK/emulator/emulator" -list-avds | grep -qx "$AVD" ||
    { echo "The Android emulator $AVD doesn't exist; ask the product owner." >&2; exit 1; }
runtime="$(xcrun simctl list runtimes -j | python3 -c '
import json, sys
ios = [r for r in json.load(sys.stdin)["runtimes"] if r["platform"] == "iOS" and r["isAvailable"]]
print(ios[-1]["identifier"] if ios else "")')"
[ -n "$runtime" ] || { echo "No iOS simulator runtime is installed; ask the product owner." >&2; exit 1; }

git -C "$repo" fetch -q origin
if [ ! -d "$tree" ]; then
    git -C "$repo" worktree add -q --detach "$tree" "origin/$branch"
else
    git -C "$tree" checkout -q --detach "origin/$branch"
fi
mkdir -p "$tree/.build"
echo "Building $branch at $(git -C "$tree" rev-parse --short HEAD) in $tree"

# Android: a read-only instance of the shared emulator on a free even port.
if [ ! -f "$port_file" ] || ! "$ADB" devices | grep -q "emulator-$(cat "$port_file")"; then
    for port in $(seq 5556 2 5584); do
        if ! nc -z 127.0.0.1 "$port" 2>/dev/null && ! nc -z 127.0.0.1 $((port + 1)) 2>/dev/null; then
            echo "$port" > "$port_file"; break
        fi
    done
    nohup "$SDK/emulator/emulator" -avd "$AVD" -read-only -port "$(cat "$port_file")" -gpu host \
        > "$tree/.build/emulator.log" 2>&1 &
fi
export ANDROID_SERIAL="emulator-$(cat "$port_file")"

# iOS: a simulator of this session's own.
udid="$(simulator)"
[ -n "$udid" ] || udid="$(xcrun simctl create "$name" "$DEVICE_TYPE" "$runtime")"
xcrun simctl bootstatus "$udid" -b >/dev/null
(
    cd "$tree/ios"
    xcodebuild -project Cute.xcodeproj -scheme Cute -destination "id=$udid" \
        -derivedDataPath "$tree/.build/DerivedData" build -quiet
)
app="$(find "$tree/.build/DerivedData/Build/Products" -maxdepth 2 -name Cute.app | head -1)"
xcrun simctl install "$udid" "$app"
xcrun simctl launch "$udid" "$APP_ID" >/dev/null
open "$(xcode-select -p)/../Applications/DeviceHub.app"
echo "iOS: running on simulator $name; pick it in Device Hub."

(
    cd "$tree/android"
    ./gradlew -q -Dorg.gradle.java.home="$JAVA_HOME" assembleDebug
)
"$ADB" wait-for-device
until [ "$("$ADB" shell getprop sys.boot_completed | tr -d '\r')" = 1 ]; do sleep 2; done
[ "$("$ADB" emu avd name | head -1 | tr -d '\r')" = "$AVD" ] ||
    { echo "$ANDROID_SERIAL isn't the instance this script started." >&2; exit 1; }
"$ADB" install -r "$(find "$tree/android/app/build/outputs/apk/debug" -name '*.apk' | head -1)" >/dev/null
"$ADB" shell am start -W -n "$APP_ID/.MainActivity" >/dev/null
echo "Android: running in the emulator window, $ANDROID_SERIAL."
echo "When the product owner is done: scripts/run-both --stop $branch"
